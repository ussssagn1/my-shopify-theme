{% style %}
  #{{ section.id }}.c-lct {
    width: 100%;
    padding: 40px 20px;
    box-sizing: border-box;
    background: #0E1120;
  }

  #{{ section.id }} .c-lct-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  #{{ section.id }} .c-lct-heading-mobile {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 1.1;
    color: #fff;
    text-align: center;
    margin: 0;
  }

  #{{ section.id }} .c-lct-table {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    row-gap: 12px;
    column-gap: 4px;
  }

  #{{ section.id }} .c-lct-col-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding-bottom: 15px;
  }

  #{{ section.id }} .c-lct-col-head--label {
    align-items: flex-start;
    justify-content: flex-end;
    padding-bottom: 15px;
  }

  #{{ section.id }} .c-lct-heading-desktop {
    display: none;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 44px;
    line-height: 1.1;
    color: #fff;
    margin: 0;
  }

  #{{ section.id }} .c-lct-comparison-label {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #fff;
    margin: 0;
  }

  #{{ section.id }} .c-lct-product-img {
    width: auto;
    max-width: 75px;
    height: 72px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-lct-logo-img {
    width: auto;
    max-width: 90px;
    height: 32px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-lct-competitor-img {
    width: auto;
    max-width: 60px;
    height: 60px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-lct-competitor-label {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 11px;
    line-height: 1.2;
    color: #fff;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
  }

  #{{ section.id }} .c-lct-cell {
    min-height: 60px;
    border-radius: 12px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: normal;
    text-align: center;
    letter-spacing: 0;
  }

  #{{ section.id }} .c-lct-cell--feature {
    background: #fff;
    border: 1px solid #E5E5E5;
    color: #1B1B1B;
    font-weight: 400;
  }

  #{{ section.id }} .c-lct-cell--monti {
    background-color: #fff;
    background-image: linear-gradient(rgba(0, 148, 61, 0.12), rgba(0, 148, 61, 0.12));
    color: #00943D;
    font-weight: 600;
  }

  #{{ section.id }} .c-lct-cell--competitor {
    background-color: #fff;
    background-image: linear-gradient(rgba(193, 51, 37, 0.05), rgba(193, 51, 37, 0.05));
    border: 1px solid #E5E5E5;
    color: #E43C33;
    font-weight: 600;
  }

  #{{ section.id }} .c-lct-btn-wrap {
    display: flex;
    justify-content: center;
  }

  #{{ section.id }} .c-lct-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 60px;
    border-radius: 10px;
    border: 2px solid #fe8585;
    background: linear-gradient(90deg, #c5200f 38.46%, #e14b3c 100%);
    box-shadow: 0 0 3px #ff5252, inset 0 0 26px 0 #ff7d7d;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.29;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  #{{ section.id }} .c-lct-btn:hover { opacity: 0.92; }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-lct {
      padding: 64px;
    }

    #{{ section.id }} .c-lct-inner {
      gap: 49px;
    }

    #{{ section.id }} .c-lct-heading-mobile {
      display: none;
    }

    #{{ section.id }} .c-lct-table {
      column-gap: 16px;
    }

    #{{ section.id }} .c-lct-col-head--label {
      justify-content: end;
      padding-bottom: 28px;
    }

    #{{ section.id }} .c-lct-heading-desktop {
      display: block;
    }

    #{{ section.id }} .c-lct-comparison-label {
      display: none;
    }

    #{{ section.id }} .c-lct-product-img {
      max-width: 102px;
      height: 98px;
    }

    #{{ section.id }} .c-lct-logo-img {
      max-width: 118px;
      height: 44px;
    }

    #{{ section.id }} .c-lct-competitor-img {
      max-width: 78px;
      height: 87px;
    }

    #{{ section.id }} .c-lct-competitor-label {
      font-size: 22px;
      font-weight: 600;
      text-transform: none;
      letter-spacing: 0;
    }

    #{{ section.id }} .c-lct-cell {
      font-size: 20px;
      padding: 16px 24px;
    }

    #{{ section.id }} .c-lct-cell--feature {
      justify-content: flex-start;
      text-align: left;
    }

    #{{ section.id }} .c-lct-cell--monti {
      border: 2px solid #fff;
      font-weight: 700;
    }

    #{{ section.id }} .c-lct-cell--competitor {
      border: 2px solid #fff;
      background-image: linear-gradient(rgba(193, 51, 37, 0.12), rgba(193, 51, 37, 0.12));
      font-weight: 700;
    }

    #{{ section.id }} .c-lct-btn {
      width: auto;
      padding: 0 63px;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="c-lct">
  <div class="c-lct-inner">

    {% if section.settings.heading != blank %}
      <h2 class="c-lct-heading-mobile">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="c-lct-table">

      <div class="c-lct-col-head c-lct-col-head--label">
        {% if section.settings.heading != blank %}
          <h2 class="c-lct-heading-desktop">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.comparison_label != blank %}
          <p class="c-lct-comparison-label">{{ section.settings.comparison_label }}</p>
        {% endif %}
      </div>

      <div class="c-lct-col-head">
        {% if section.settings.monti_product_image != blank %}
          {{
            section.settings.monti_product_image
            | image_url: width: 210
            | image_tag:
              class: 'c-lct-product-img',
              loading: 'lazy',
              alt: section.settings.monti_label
          }}
        {% endif %}
        {% if section.settings.monti_logo != blank %}
          {{
            section.settings.monti_logo
            | image_url: width: 240
            | image_tag:
              class: 'c-lct-logo-img',
              loading: 'lazy',
              alt: section.settings.monti_label
          }}
        {% endif %}
      </div>

      <div class="c-lct-col-head">
        {% if section.settings.competitor_product_image != blank %}
          {{
            section.settings.competitor_product_image
            | image_url: width: 160
            | image_tag:
              class: 'c-lct-competitor-img',
              loading: 'lazy',
              alt: section.settings.competitor_label
          }}
        {% endif %}
        {% if section.settings.competitor_label != blank %}
          <p class="c-lct-competitor-label">{{ section.settings.competitor_label }}</p>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        <div class="c-lct-cell c-lct-cell--feature" {{ block.shopify_attributes }}>
          {{ block.settings.feature }}
        </div>
        <div class="c-lct-cell c-lct-cell--monti">
          {{ block.settings.monti_value }}
        </div>
        <div class="c-lct-cell c-lct-cell--competitor">
          {{ block.settings.competitor_value }}
        </div>
      {% endfor %}

    </div>

    {% if section.settings.button_text != blank %}
      <div class="c-lct-btn-wrap">
        <a href="{{ section.settings.button_url }}" class="c-lct-btn">
          {{ section.settings.button_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M5 12H19M13 6L19 12L13 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Listicle Comparison Table",
  "tag": "section",
  "blocks": [
    {
      "name": "Row",
      "type": "row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Weight"
        },
        {
          "type": "text",
          "id": "monti_value",
          "label": "Monti value",
          "default": "17 oz"
        },
        {
          "type": "text",
          "id": "competitor_value",
          "label": "Competitor value",
          "default": "7+ lbs"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Monti vs Hard Coolers At a Glance"
    },
    {
      "type": "text",
      "id": "comparison_label",
      "label": "Comparison column label (mobile)",
      "default": "Comparison"
    },
    {
      "type": "header",
      "content": "Monti column"
    },
    {
      "type": "image_picker",
      "id": "monti_product_image",
      "label": "Product image"
    },
    {
      "type": "image_picker",
      "id": "monti_logo",
      "label": "Logo / wordmark",
      "info": "Upload a white version for the dark background"
    },
    {
      "type": "text",
      "id": "monti_label",
      "label": "Alt text",
      "default": "Monti"
    },
    {
      "type": "header",
      "content": "Competitor column"
    },
    {
      "type": "image_picker",
      "id": "competitor_product_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "competitor_label",
      "label": "Competitor label",
      "default": "Regular hard cooler"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Buy the Shasta"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "C Listicle Comparison Table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature": "Weight",
            "monti_value": "17 oz",
            "competitor_value": "7+ lbs"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Packed size",
            "monti_value": "Fits in carry-on",
            "competitor_value": "Takes up whole trunk"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Ice retention",
            "monti_value": "55 hours",
            "competitor_value": "10-12 hours"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Machine washable",
            "monti_value": "Yes",
            "competitor_value": "No"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Carry options",
            "monti_value": "Backpack, tote, sling",
            "competitor_value": "Handle only"
          }
        },
        {
          "type": "row",
          "settings": {
            "feature": "Price",
            "monti_value": "From $129",
            "competitor_value": "$250–$400+"
          }
        }
      ]
    }
  ]
}
{% endschema %}
