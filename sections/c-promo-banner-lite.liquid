
{% style %}
  #{{ section.id }}.c-promo-horizontal-section {
    padding: 30px 20px 60px;
  }

  #{{ section.id }} .c-promo-horizontal-wrap {
    background: #192A3F;
    border-radius: 25px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 27px 30px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: relative;
    overflow: hidden;
    min-height: 400px;
  }

  .c-promo-lite-sale {
    position: absolute;
    bottom: 0;
    right: -60px;
    z-index: 1;
  }

  .c-promo-lite-badge {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
  }

  .c-promo-lite-circle {
    position: absolute;
    bottom: 50px;
    left: 0;
    z-index: 1;
  }

  #{{ section.id }} .c-promo-horizontal-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.25;
  }

  #{{ section.id }} .c-promo-horizontal-bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section.id }} .c-promo-horizontal-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  #{{ section.id }} .c-promo-horizontal-image {
    width: 100%;
    max-width: 437px;
  }

  #{{ section.id }} .c-promo-horizontal-image img,
  #{{ section.id }} .c-promo-horizontal-image svg {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  #{{ section.id }} .c-promo-horizontal-image svg {
    background-color: #AFAFAF;
  }

  #{{ section.id }} .c-promo-horizontal-body {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  #{{ section.id }} .c-promo-horizontal-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #{{ section.id }} .c-promo-horizontal-heading {
    font-family: 'Inter', sans-serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    color: #FFFFFF;
    letter-spacing: -1.68px;
    margin: 0;
  }

  #{{ section.id }} .c-promo-horizontal-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    color: #FFFFFF;
    letter-spacing: 0.6px;
    margin: 0;
    max-width: 80%;
  }

  #{{ section.id }} .c-promo-horizontal-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 70px;
    background: #C13325;
    color: #FFFFFF;
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.55;
    text-decoration: none;
    letter-spacing: 0.6px;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  #{{ section.id }} .c-promo-horizontal-button:hover {
    opacity: 0.9;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .c-promo-horizontal-heading {
      font-size: 46px;
    }

    #{{ section.id }} .c-promo-horizontal-text {
      font-size: 18px;
    }

    #{{ section.id }} .c-promo-horizontal-button {
      width: auto;
    }
    .c-promo-lite-sale {
      right: 0;
    }
  }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-promo-horizontal-section {
      padding: 67px 20px 110px;
    }

    #{{ section.id }} .c-promo-horizontal-wrap {
      flex-direction: row;
      gap: 60px;
      padding: 27px 30px;
      align-items: center;
    }

    #{{ section.id }} .c-promo-horizontal-content {
      flex-direction: row;
      gap: 60px;
      align-items: center;
    }

    #{{ section.id }} .c-promo-horizontal-text {
      max-width: none;
    }
    
    #{{ section.id }} .c-promo-horizontal-image {
      flex: 0 0 35%;
      max-width: 437px;
    }

    #{{ section.id }} .c-promo-horizontal-body {
      flex: 1;
      max-width: 48%
    }

    #{{ section.id }} .c-promo-horizontal-heading {
      font-size: 56px;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="c-promo-horizontal-section">
  <div class="c-promo-horizontal-wrap">
    
    {%- if section.settings.background_image -%}
      <div class="c-promo-horizontal-bg-image">
        {{ section.settings.background_image | image_url: width: 2800 | image_tag: loading: 'lazy', widths: '1400, 2800' }}
      </div>
    {%- endif -%}

