{% style %}
  #{{ section.id }}.c-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: #fff;
    width: 100vw;
    box-sizing: border-box;
    box-shadow: 0px 5px 15px 0px rgba(0,0,0,0.05);
  }

  #{{ section.id }} .c-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 70px;
    height: 80px;
    position: relative;
    box-sizing: border-box;
  }

  #{{ section.id }} .c-header__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  #{{ section.id }} .c-header__logo img {
    max-height: 60px;
    width: auto;
    display: block;
  }

  #{{ section.id }} .c-header__logo-text {
    font-family: 'Inter', sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #C13325;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #{{ section.id }} .c-header__nav {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  #{{ section.id }} .c-header__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #C13325;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.1;
    padding: 9px 14px;
    border-radius: 20px;
    text-decoration: none;
    white-space: nowrap;
    margin-right: 24px;
    transition: opacity 0.2s, background-color 0.2s;
  }

  #{{ section.id }} .c-header__badge:hover {
    opacity: 0.88;
    color: #fff;
    text-decoration: none;
  }

  #{{ section.id }} .c-header__nav-link {
    display: inline-flex;
    align-items: center;
    padding: 10px 24px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    color: #000;
    text-decoration: none;
    white-space: nowrap;
    text-transform: capitalize;
    transition: text-decoration 0.15s, color 0.15s;
  }

  #{{ section.id }} .c-header__nav-link:hover {
    text-decoration: underline;
    color: #000;
  }

  #{{ section.id }} .c-header__mega {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  #{{ section.id }} .c-header__mega-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    color: #000;
    white-space: nowrap;
    text-transform: capitalize;
    text-decoration: none;
    -webkit-appearance: none;
    appearance: none;
    transition: font-weight 0.15s;
  }

  #{{ section.id }} .c-header__mega-trigger svg {
    width: 10px;
    height: 6px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  #{{ section.id }} .c-header__mega:hover .c-header__mega-trigger,
  #{{ section.id }} .c-header__mega.is-open .c-header__mega-trigger {
    text-decoration: underline;
  }

  #{{ section.id }} .c-header__mega:hover .c-header__mega-trigger svg,
  #{{ section.id }} .c-header__mega.is-open .c-header__mega-trigger svg {
    transform: rotate(180deg);
  }

  #{{ section.id }} .c-header__dropdown {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: #fff;
    border-radius: 4px;
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.25), 0 8px 24px rgba(0, 0, 0, 0.08);
    padding: 8px;
    z-index: 10;
    box-sizing: border-box;
    min-width: max-content;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }

  #{{ section.id }} .c-header__mega:hover .c-header__dropdown,
  #{{ section.id }} .c-header__mega.is-open .c-header__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  #{{ section.id }} .c-header__product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 230px;
    flex-shrink: 0;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  #{{ section.id }} .c-header__product-card:hover {
    opacity: 0.85;
  }

  #{{ section.id }} .c-header__product-img-wrap {
    position: relative;
    width: 230px;
    height: 198px;
    border: 1px solid rgba(193, 51, 37, 0.15);
    border-radius: 4px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 10px 31px;
    box-sizing: border-box;
    overflow: hidden;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-header__product-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
    display: block;
  }

  #{{ section.id }} .c-header__best-seller {
    position: absolute;
    top: 9px;
    right: 9px;
    background: #C13325;
    border: 1px solid rgba(193, 51, 37, 0.5);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.6px;
    padding: 5px 8px;
    border-radius: 4px;
    white-space: nowrap;
    background-clip: padding-box;
  }

  #{{ section.id }} .c-header__product-name {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.29;
    color: #222;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
    width: 100%;
  }

  #{{ section.id }} .c-header__links-col {
    min-width: 230px;
    height: fit-content;
    background-color: rgba(193, 51, 37, 0.05);
    border: 1px solid rgba(193, 51, 37, 0.15);
    border-radius: 4px;
    padding: 30.5px 26px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    flex-shrink: 0;
    align-self: stretch;
  }

  #{{ section.id }} .c-header__links-list {
    display: flex;
    flex-direction: column;
    gap: 11px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #{{ section.id }} .c-header__links-list a {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #000;
    text-decoration: none;
    display: block;
  }

  #{{ section.id }} .c-header__links-list a:hover {
    text-decoration: underline;
  }

  #{{ section.id }} .c-header__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #C13325;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.29;
    padding: 4px 8px;
    border-radius: 4px;
    text-decoration: none;
    width: fit-content;
    transition: opacity 0.2s;
  }

  #{{ section.id }} .c-header__view-all:hover {
    opacity: 0.88;
    color: #fff;
    text-decoration: none;
  }

  #{{ section.id }} .c-header__icons {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #000;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
    position: relative;
  }

  #{{ section.id }} .c-header__icon-btn:hover {
    opacity: 0.6;
  }

  #{{ section.id }} .c-header__icon-btn svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  #{{ section.id }} .c-header__burger {
    display: none;
  }

  #{{ section.id }} .c-header__mobile-left {
    display: none;
  }

  #{{ section.id }} .c-header__icon-btn--mobile-only {
    display: none;
  }

  .c-header-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 390px;
    height: 100%;
    background: #fff;
    z-index: 300;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow: hidden;
    box-sizing: border-box;
  }

  .c-header-drawer.is-open {
    transform: translateX(0);
  }
  
  .c-header-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    box-sizing: border-box;
  }

  .c-header-drawer__head img {
    max-height: 43px;
    width: auto;
    display: block;
  }

  .c-header-drawer__close {
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .c-header-drawer__close svg {
    width: 28px;
    height: 28px;
  }

  .c-header-drawer__divider {
    width: 100%;
    height: 1px;
    background: #e5e5e5;
    border: none;
    margin: 0;
  }

  .c-header-drawer__body {
    display: flex;
    flex-direction: column;
    height: calc(100% - 73px);
    overflow-y: auto;
  }

  .c-header-drawer__badge-wrap {
    padding: 16px 20px;
  }

  .c-header-drawer__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #C13325;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.1;
    padding: 9px 14px;
    border-radius: 20px;
    text-decoration: none;
    white-space: nowrap;
    text-transform: capitalize;
  }

  .c-header-drawer__nav {
    display: flex;
    flex-direction: column;
  }

  .c-header-drawer__item {
    display: flex;
    flex-direction: column;
  }

  .c-header-drawer__item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 31px;
    min-height: 64px;
    box-sizing: border-box;
  }

  .c-header-drawer__item-label {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.1;
    color: #000;
    text-decoration: none;
    text-transform: capitalize;
  }

  .c-header-drawer__item-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.1;
    color: #000;
    text-transform: capitalize;
    -webkit-appearance: none;
    appearance: none;
  }

  .c-header-drawer__item-btn svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: #000;
  }

  .c-header-drawer__card {
    margin: 24px 20px 32px;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    height: 274px;
    flex-shrink: 0;
    display: block;
    text-decoration: none;
  }

  .c-header-drawer__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .c-header-drawer__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(179.69deg, rgba(0,0,0,0) 0.49%, rgba(0,0,0,0.4) 99.8%);
    pointer-events: none;
  }

  .c-header-drawer__card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  .c-header-drawer__card-title {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #fff;
    margin: 0;
  }

  .c-header-drawer__card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #C13325;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.29;
    padding: 4px 8px;
    border-radius: 4px;
    text-decoration: none;
    white-space: nowrap;
  }

  .c-header-drawer__card-btn:hover {
    color: #fff;
    text-decoration: none;
    opacity: 0.88;
  }

  .c-header-sub {
    position: absolute;
    inset: 0;
    background: #fff;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .c-header-sub.is-open {
    transform: translateX(0);
  }

  .c-header-sub__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    flex-shrink: 0;
  }

  .c-header-sub__back {
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .c-header-sub__back svg {
    width: 28px;
    height: 28px;
  }

  .c-header-sub__title {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.29;
    color: #000;
    text-align: center;
    flex: 1;
  }

  .c-header-sub__close {
    width: 28px;
    height: 28px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .c-header-sub__close svg {
    width: 28px;
    height: 28px;
  }

  .c-header-sub__body {
    padding: 25px 18px 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .c-header-sub__product-full {
    position: relative;
    border: 1px solid rgba(193, 51, 37, 0.15);
    border-radius: 6px;
    height: 253px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px 9px 4px;
    box-sizing: border-box;
    text-decoration: none;
    overflow: hidden;
    flex-shrink: 0;
  }

  .c-header-sub__product-full img {
    max-height: 209px;
    max-width: 208px;
    object-fit: contain;
    display: block;
    flex: 1;
  }

  .c-header-sub__product-full .c-header-sub__product-name {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.29;
    color: #000;
    text-transform: uppercase;
    text-align: center;
    position: absolute;
    top: 11px;
    left: 9px;
    margin: 0;
  }

  .c-header-sub__badge {
    position: absolute;
    top: 13px;
    right: 13px;
    background: #C13325;
    border: 1px solid rgba(193, 51, 37, 0.5);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.6px;
    padding: 7px 8px;
    border-radius: 4px;
    white-space: nowrap;
    background-clip: padding-box;
  }

  .c-header-sub__row {
    display: flex;
    gap: 8px;
    min-width: 0;
  }

  .c-header-sub__product-half {
    position: relative;
    border: 1px solid rgba(193, 51, 37, 0.15);
    border-radius: 6px;
    flex: 1;
    min-width: 0;
    min-height: 155px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4px 9px 11px;
    box-sizing: border-box;
    text-decoration: none;
    overflow: hidden;
    gap: 4px;
  }

  .c-header-sub__product-half .c-header-sub__product-name {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.29;
    color: #000;
    text-transform: uppercase;
    text-align: center;
    margin: 0;
    width: 100%;
  }

  .c-header-sub__product-half img {
    width: 90px;
    height: 110px;
    object-fit: contain;
    display: block;
    flex: 1;
  }

  .c-header-sub__links-col {
    background: rgba(193, 51, 37, 0.05);
    border: 1px solid rgba(193, 51, 37, 0.15);
    border-radius: 4px;
    flex: 1;
    min-width: 0;
    min-height: 155px;
    padding: 16px 11px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }

  .c-header-sub__links-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .c-header-sub__links-list a {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #222;
    text-decoration: none;
  }

  .c-header-sub__links-list a:hover {
    text-decoration: underline;
  }

  .c-header-sub__view-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #C13325;
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.29;
    padding: 4px 8px;
    border-radius: 4px;
    text-decoration: none;
    width: fit-content;
  }

  .c-header-sub__view-all:hover {
    opacity: 0.88;
    color: #fff;
    text-decoration: none;
  }

  details[open] .modal-overlay:after {
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
  }

  .c-header-overlay {
    display: block !important;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5); 
    z-index: 299;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
  }

  .c-header-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .cart-count-bubble {
    bottom: 1.2rem !important;
    left: 1.3rem !important;
  }

  .c-header-drawer__item-arrow {
    display: flex;
    align-items: center;
    justify-content: end;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    -webkit-appearance: none;
    appearance: none;
    flex: 1 1 0;
  }

  .c-header-drawer__item-arrow svg {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: #000;
  }

  @media screen and (max-width: 1225px) {
    #{{ section.id }} .c-header__mega-trigger,
    #{{ section.id }} .c-header__nav-link {
      padding: 10px 11px;
    }

    #{{ section.id }} .c-header__badge {
      margin-right: 11px;
    }
  }

  @media screen and (max-width: 1023px) {
    #{{ section.id }} .c-header__inner {
      padding: 0 20px;
      position: relative;
    }

    #{{ section.id }} .c-header__logo {
      transform: translateX(-18%);
    }

    #{{ section.id }} .c-header__logo img {
      max-height: 43px;
    }


    #{{ section.id }} .c-header__nav {
      display: none;
    }

    #{{ section.id }} .c-header__mobile-left {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-shrink: 0;
    }    

    #{{ section.id }} .c-header__icon-btn--mobile-only,
    #{{ section.id }} .c-header__icon-btn--mobile-only .c-header__icon-btn--search {
      display: flex !important;
    }

    #{{ section.id }} .c-header__icon-btn--search,
    #{{ section.id }} .c-header__icon-btn--account {
      display: none;
    }

    #{{ section.id }} .c-header__burger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      flex-shrink: 0;
      transition: opacity 0.2s;
    }

    #{{ section.id }} .c-header__burger:hover {
      opacity: 0.6;
    }

    #{{ section.id }} .c-header__burger svg {
      width: 28px;
      height: 28px;
    }
  }
{% endstyle %}

<header id="{{ section.id }}" class="c-header">
  <div class="c-header__inner">

    <div class="c-header__mobile-left">
      <button type="button" class="c-header__burger" id="c-header-burger-{{ section.id }}" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M4 6H20M4 12H20M4 18H20" stroke="#222222" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="c-header__icon-btn--mobile-only">
        {% render 'c-header-search', input_id: 'Search-In-Modal-1' %}
      </div>
    </div>

    <a class="c-header__logo" href="/">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 300 | image_tag: loading: 'eager', class: 'c-header__logo-img' }}
      {%- else -%}
        <span class="c-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="c-header__nav">
      {%- if section.settings.badge_text != blank -%}
        <a class="c-header__badge" href="{{ section.settings.badge_url | default: '#' }}">
          {{ section.settings.badge_text }}
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- assign has_submenu = false -%}
        {%- if block.settings.products != blank or block.settings.menu != blank or block.settings.view_all_url != blank -%}
          {%- assign has_submenu = true -%}
        {%- endif -%}

        {%- if has_submenu -%}
          <div class="c-header__mega" {{ block.shopify_attributes }}>
            <a class="c-header__mega-trigger" href="{{ block.settings.url | default: '#' }}">
              {{ block.settings.label }}
              <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>

            <div class="c-header__dropdown" role="region">
              {%- if block.settings.products != blank -%}
                {%- assign prod_index = 0 -%}
                {%- for prod in block.settings.products -%}
                  {%- if prod_index < 4 -%}
                    <a class="c-header__product-card" href="{{ prod.url }}">
                      <div class="c-header__product-img-wrap">
                        {%- if prod.featured_image != blank -%}
                          {{ prod.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                        {%- endif -%}
                        {%- if prod_index == 0 and block.settings.first_product_badge -%}
                          <span class="c-header__best-seller">Best Seller</span>
                        {%- endif -%}
                      </div>
                      <p class="c-header__product-name">{{ prod.title }}</p>
                    </a>
                  {%- endif -%}
                  {%- assign prod_index = prod_index | plus: 1 -%}
                {%- endfor -%}
              {%- endif -%}

              {%- assign nav_menu = linklists[block.settings.menu] -%}
              {%- if nav_menu.links.size > 0 or block.settings.view_all_url != blank -%}
                <div class="c-header__links-col">
                  {%- if nav_menu.links.size > 0 -%}
                    <ul class="c-header__links-list">
                      {%- for link in nav_menu.links -%}
                        <li><a href="{{ link.url }}">- {{ link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if block.settings.view_all_url != blank -%}
                    <a class="c-header__view-all" href="{{ block.settings.view_all_url }}">
                      {{ block.settings.view_all_text | default: 'View All' }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>

        {%- else -%}
          <a class="c-header__nav-link" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="c-header__icons">
      {% render 'c-header-search', input_id: 'Search-In-Modal-1' %}
      <a class="c-header__icon-btn c-header__icon-btn--account" href="/account">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M4 20c0-4 3.582-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="c-header__icon-btn c-header__icon-btn--cart link focus-inset" id="cart-icon-bubble">
