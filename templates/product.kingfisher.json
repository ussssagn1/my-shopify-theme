    "c_faq_without_tabs_r3Gxhw": {
      "type": "c-faq-without-tabs",
      "blocks": {
        "item_UtRinn": {
          "type": "Item",
          "settings": {
            "faq_heading": "How does the tote-to-backpack switch work?",
            "faq_answer": "<p>Adjustable straps are built in. Tuck them away for tote mode, pull them out and clip in for backpack mode. Takes about 5 seconds.</p>"
          }
        },
        "item_CGjzMT": {
          "type": "Item",
          "settings": {
            "faq_heading": "How does it compare to the Shasta?",
            "faq_answer": "<p>The Kingfisher is a tote-first cooler with more capacity (36 cans vs 24). The Shasta is a backpack-first cooler that's lighter and more compact. Choose the Kingfisher if you want max capacity and carry versatility.</p>"
          }
        },
        "item_8qQEpJ": {
          "type": "Item",
          "settings": {
            "faq_heading": "Does it fit in a carry-on?",
            "faq_answer": "<p>Yes. When folded into its stuff sack (10\"×3\"×9\") it fits in any standard carry-on, tote, or under-seat bag.</p>"
          }
        },
        "item_NJe6UD": {
          "type": "Item",
          "settings": {
            "faq_heading": "Is it leak-proof?",
            "faq_answer": "<p>Yes. Waterproof liner + waterproof YKK zippers. Roll the top tight for a full seal, like a dry bag.</p>"
          }
        },
        "item_DWBXdt": {
          "type": "Item",
          "settings": {
            "faq_heading": "What if my cooler arrives damaged?",
            "faq_answer": "<p>Reach out to <a href=\"mailto:team@monticoolers.com\">team@monticoolers.com</a> and they'll replace it. 90-day warranty on defects.</p>"
          }
        },
        "item_MfjCfn": {
          "type": "Item",
          "settings": {
            "faq_heading": "Can I wash it?",
            "faq_answer": "<p>Yes. Turn inside out, hand wash with cold water, or toss it in the machine on cold.</p>"
          }
        }
      },
