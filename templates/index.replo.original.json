    "16492701492e84e4d8": {
      "type": "collapsible-content",
      "blocks": {
        "164927014981a874d3-0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How does it work?",
            "icon": "chat_bubble",
            "row_content": "<p>Your cooler has a built in stuff sack for when you're not using it. Not using it? Simply stuff your cooler into it's pocket. When you're ready to go, just pop it out and add ice!</p>",
            "page": ""
          }
        },
        "164927014981a874d3-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I seal my Monti?",
            "icon": "chat_bubble",
            "row_content": "<p>For best results, roll the top of your cooler a minimum of 2 times, then clip shut. 3 rolls is even better.</p>",
            "page": ""
          }
        },
        "164927014981a874d3-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I already own a \"big brand cooler\", why do I need a Monti?",
            "icon": "chat_bubble",
            "row_content": "<p>We love our big roto-molded coolers! It is great as a mothership in the car or house. When it comes time to go out on a hike, fishing, park day, grocery run, or anything away from traditional heavy coolers, that is the perfect time to grab your Monti! #bettertogether</p>",
            "page": ""
          }
        },
        "164927014981a874d3-3": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Does it leak?",
            "icon": "chat_bubble",
            "row_content": "<p>Your</p>",
            "page": ""
          }
        },
        "98027faa-072e-49fb-b5ce-cf7e7700c576": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is shipping free?",
            "icon": "chat_bubble",
            "row_content": "<p>Yes! We off free shipping in the USA.</p>",
            "page": ""
          }
        },
        "494964fe-7119-4314-873c-e45037d9b93f": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the return policy?",
            "icon": "chat_bubble",
            "row_content": "<p>If you don't love it, return your cooler for a complete refund. More details in our return page below. </p>",
            "page": ""
          }
        },
        "ab5342f8-4232-46e8-8c3c-7db84e537b7a": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are you made in the USA?",
            "icon": "chat_bubble",
            "row_content": "<p>Absolutely! We proudly manufacture in Indiana. </p>",
            "page": ""
          }
        }
      },
