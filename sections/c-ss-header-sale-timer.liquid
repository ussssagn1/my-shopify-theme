        {{ section.settings.bottom_left_flowers_image | image_url: width: 1600 | image_tag: class: 'c-ss-bg-bottom-left', loading: 'lazy', widths: '400, 736, 1100, 1600', alt: '' }}
      {%- else -%}
        <svg class="c-ss-bg-bottom-left" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 736 263" fill="none" aria-hidden="true">
          <g>
            <path d="M39 262C59 201 84 190 117 233" stroke="#2E646D" stroke-width="3.8" stroke-linecap="round"/>
