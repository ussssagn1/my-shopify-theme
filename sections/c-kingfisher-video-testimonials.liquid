{% # swiper %}
<link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}"/>
<script src="{{ 'swiper-bundle.min.js' | asset_url }}"></script>


<style>
  #{{ section.id }} {
    font-size: 16px;
    padding-top: {{ section.settings.padding_top }}em;
    padding-bottom: {{ section.settings.padding_bottom }}em;
    background-color: {{ section.settings.bg_color }};
  }

  #{{ section.id }} div,
  #{{ section.id }} h2,
  #{{ section.id }} h3 {
    color: {{ section.settings.text_color }};
  }

  #{{ section.id }} .page-width {
    max-width: 1650px;
  }

  #{{ section.id }} .c-section-top {
    align-items: {{ section.settings.section_top_alignment }};
    text-align: {{ section.settings.section_top_text_alignment }};
  }

  #{{ section.id }} .swiper-wrapper {
    padding-bottom: 0px;
  }

  #{{ section.id }} .c-vt-card {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-direction: column;
    box-shadow: 0px 5px 10px 2px rgba(0,0,0,0.2);
    position: relative;
  }

  #{{ section.id }} .c-vt-card video {
    width: 100%;
    border-radius: 16px;
    border: 5px solid #1e2937;
  }

  #{{ section.id }} .c-vt-card .c-vt-paragraph {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 10px;
    border-radius: 15px;
    background-color: #2C2B2B;
    color: #fff;
    font-size: 14px;
    line-height: 14px;
    font-weight: 500;
    /* z-index: 0; */
  }


  #{{ section.id }} .c-vt-grid {
    display: grid; 
    grid-template-columns:{% for i in (1..section.settings.columns) %} 1fr{% endfor %};
    column-gap: 2rem;
    row-gap: 2rem;
    width: {{ section.settings.container_width }}%;
    {% if section.settings.container_alignment == "center" %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  #{{ section.id }} .c-vt-video-div {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    text-align: center;
  }

  #{{ section.id }} .c-vt-video {
    width: 100%;
    border-radius: 0em;
  }

  #{{ section.id }} .c-vt-paragraph a {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 2px;    
  }





  #{{ section.id }} .c-vt-arrows {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
  }

  #{{ section.id }} .c-vt-arrows .swiper-arrow {
    position: relative;
    width: 2.5em;
    height: 2.5em;
    margin-top: 0px;
    background-color: transparent;
    border: 1px solid {{ section.settings.text_color }};
    border-radius: 999px;
    z-index: 11;
  }

  #{{ section.id }} .c-vt-arrows .swiper-arrow::after {
    font-size: 1.2rem;
  }

  #{{ section.id }} .c-vt-arrows .swiper-arrow:hover {
    background: var(--primary1);
    border-color: var(--primary1);
  }

  #{{ section.id }} .swiper-horizontal>.swiper-pagination-bullets,
  #{{ section.id }} .swiper-pagination-bullets.swiper-pagination-horizontal {
    bottom: 0px;
  }

  #{{ section.id }} .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.4);
    margin: 0 4px;
    cursor: pointer;
    border-radius: 999px;
    opacity: 1;
  }

  #{{ section.id }} .swiper-pagination-bullet:hover {
    background: rgba(255,255,255,1);
  }

  #{{ section.id }} .swiper-pagination-bullet.swiper-pagination-bullet-active {
    background: var(--primary1);
  }

  @media (max-width: {{ settings.c_breakpoint3 }}px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 }}em;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 }}em;
    }

    #{{ section.id }} .c-vt-grid {
      grid-template-columns:{% for i in (1..section.settings.mobile_columns) %} 1fr{% endfor %};
    }
  }
</style>


{% liquid
  assign vAutoplay = section.settings.autoplay
  assign vLoop = section.settings.loop
  assign vMuted = section.settings.muted
  assign vControls = section.settings.controls
%}


<div class="c-section-between">
  <section id="{{ section.id }}" class="c-section">
    <div class="page-width">
      <div class="c-section-top">
        {%- if section.settings.section_top_subheading != empty -%}<p class="c-section-top-subheading">{{ section.settings.section_top_subheading }}</p>{%- endif -%}
        {%- if section.settings.section_top_heading != empty -%}<h2>{{ section.settings.section_top_heading }}</h2>{%- endif -%}
        {%- if section.settings.section_top_paragraph != empty -%}<div>{{ section.settings.section_top_paragraph }}</div>{%- endif -%}
      </div>
      {% if section.settings.use_slider %}
        <div class="swiper mySwiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'Item' %}
                  <div class="c-vt-card swiper-slide">
                    {% assign myPoster = block.settings.video.preview_image | image_url %}
                    {{ block.settings.video | video_tag: autoplay: vAutoplay, loop: vLoop, muted: vMuted, controls: vControls, class: 'c-vt-video', poster: myPoster }}
                    {%- if block.settings.block_paragraph != empty -%}
                      <div class="c-vt-paragraph">{{ block.settings.block_paragraph }}</div>
                    {%- endif -%}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
          <div class="c-vt-arrows">
            <div class="swiper-button-prev swiper-arrow"></div>
            <div class="swiper-button-next swiper-arrow"></div>
          </div>
          <div class="swiper-pagination"></div>
        </div>
      {% else %}
        <div class="c-vt-grid">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'Item' %}
                <div class="c-vt-video-div" {{ block.shopify_attributes }}>
                  {% assign myPoster = block.settings.video.preview_image | image_url %}
                  {{ block.settings.video | video_tag: autoplay: vAutoplay, loop: vLoop, muted: vMuted, controls: vControls,
                  class: 'c-vt-video', poster: myPoster }}
                  {%- if block.settings.block_paragraph != empty -%}
                    <div class="c-vt-paragraph">{{ block.settings.block_paragraph }}</div>
                  {%- endif -%}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
</div>


{% if section.settings.use_slider %}
  <script>
    document.addEventListener("DOMContentLoaded", (event) => {
      var swiper{{ section.id | replace: '-', '_' }} = new Swiper("#{{ section.id }} .mySwiper", {
        slidesPerView: 1.3,
        spaceBetween: 22,
        autoplay: {
          delay: 5000,
          disableOnInteraction: true,
          pauseOnMouseEnter: true,
        },
        breakpoints: {
          {{ settings.c_breakpoint2 }}: {  
            slidesPerView: 3.5
          },
          {{ settings.c_breakpoint3 }}: {  
            slidesPerView: 2.5
          },
          {{ settings.c_breakpoint4 }}: {  
            slidesPerView: 1.5
          }
        },
        navigation: {
          nextEl: "#{{ section.id }} .swiper-button-next",
          prevEl: "#{{ section.id }} .swiper-button-prev",
        },
        pagination: {
          el: "#{{ section.id }} .swiper-pagination",
          clickable: true,
        },
      });
    });
  </script>
{% endif %}


{% schema %}
  {
    "name": "C KF Video Testimonials",
    "blocks": [
      {
        "name": "Item",
        "type": "Item",
        "limit": 50,
        "settings": [
          {
            "type": "video",
            "id": "video",
            "label": "Video Upload"
          },
          {
            "type": "richtext",
            "id": "block_paragraph",
            "label": "Paragraph",
            "default": "<p>Lorem ipsum dolor sit amet.</p>"
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "use_slider",
        "label": "Use slider",
        "default": false
      },
      {
        "type": "range",
        "id": "container_width",
        "label": "Container width",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 100,
        "unit": "%"
      },
      {
        "type": "select",
        "id": "container_alignment",
        "label": "Container Alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "header",
        "content": "Video Settings"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "loop",
        "label": "Loop",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "muted",
        "label": "Muted",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "controls",
        "label": "Controls",
        "default": true
      },
      {
        "type": "range",
        "id": "columns",
        "label": "Columns",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "mobile_columns",
        "label": "Mobile Columns",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 2
      },
      {
        "type": "header",
        "content": "Section Colors"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#000"
      },
      {
        "type": "header",
        "content": "Section Top"
      },
      {
        "type": "text",
        "id": "section_top_subheading",
        "label": "Subheading",
        "default": "subheading"
      },
      {
        "type": "text",
        "id": "section_top_heading",
        "label": "Heading",
        "default": "Section Heading"
      },
      {
        "type": "richtext",
        "id": "section_top_paragraph",
        "label": "Paragraph",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare.</p>"
      },
      {
        "type": "select",
        "id": "section_top_alignment",
        "label": "Section Top Alignment",
        "default": "center",
        "options": [
          {
            "value": "flex-start",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "flex-end",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "section_top_text_alignment",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Section Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top",
        "min": 0,
        "max": 15,
        "step": 1,
        "default": 4,
        "unit": "rem"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 15,
        "step": 1,
        "default": 4,
        "unit": "rem"
      }
    ],
    "presets": [
      {
        "name": "C KF - Video Testimonials",
        "blocks": [
          {
            "type": "Item"
          },
          {
            "type": "Item"
          },
          {
            "type": "Item"
          }
        ]
      }
    ]
  }
{% endschema %}