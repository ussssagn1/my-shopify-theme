{% schema %}
{
  "name": "C SS Features Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional decorative background (15% opacity)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_left_flowers_image",
      "label": "Bottom left flowers image"
    },
    {
      "type": "image_picker",
      "id": "right_flower_image",
      "label": "Right flower image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Soft Cooler That Actually Works"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Feature description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "C SS Features Banner",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Long-Lasting Cold",
            "text": "Cold for 55 hours."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Ultra-Light & Packable",
            "text": "6x lighter than alternatives."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Durable & Leak-Resistant",
            "text": "Keeps your gear dry."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Adventure Ready",
            "text": "Ready for every journey."
          }
        }
      ]
    }
  ]
}
{% endschema %}
