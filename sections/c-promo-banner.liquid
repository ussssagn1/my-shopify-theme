{% style %}
  #{{ section.id }}.c-promo-section {
    padding: 30px 20px;
  }

  #{{ section.id }} .c-promo-wrap {
    background: #192A3F;
    border-radius: 25px;
    max-width: 1384px;
    margin: 0 auto;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: relative;
    overflow: hidden;
    justify-content: center;
  }

  #{{ section.id }} .c-promo-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.25;
  }

   #{{ section.id }} .c-promo-bg-circle {
    position: absolute;
    bottom: 0;
    right: 0;
  }

   #{{ section.id }} .c-promo-bg-lines {
    position: absolute;
    top: 0;
    right: 0;
  }

  #{{ section.id }} .c-promo-bg-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section.id }} .c-promo-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  #{{ section.id }} .c-promo-image {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid #FFFFFF;
    position: relative;
    max-width: 400px;
    margin: 0 auto;
  }

  #{{ section.id }} .c-promo-image img,
  #{{ section.id }} .c-promo-image svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #{{ section.id }} .c-promo-image svg {
    width: 100%;
    height: auto;
    display: block;
    background-color: #AFAFAF;
  }

  #{{ section.id }} .c-promo-image-badge {
    position: absolute;
    top: 0px;
    left: 0px;
    z-index: 2;
    max-width: 100px;
    width: 100%;
    background-color: transparent !important;
    height: fit-content !important;
  }


  #{{ section.id }} .c-promo-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 40px;
    padding: 0;
  }

  #{{ section.id }} .c-promo-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #{{ section.id }} .c-promo-heading {
    font-family: 'Inter', sans-serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    color: #FFFFFF;
    text-transform: capitalize;
    letter-spacing: -1.68px;
    margin: 0;
  }

  #{{ section.id }} .c-promo-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    color: #FFFFFF;
    letter-spacing: 0.6px;
    margin: 0;
  }

  #{{ section.id }} .c-promo-features {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  #{{ section.id }} .c-promo-feature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    border-radius: 60px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  #{{ section.id }} .c-promo-feature-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section.id }} .c-promo-feature-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #{{ section.id }} .c-promo-feature-text {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.55;
    color: #FFFFFF;
    letter-spacing: 0.6px;
    white-space: nowrap;
  }

  #{{ section.id }} .c-promo-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background: #C13325;
    color: #FFFFFF;
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.55;
    text-decoration: none;
    letter-spacing: 0.6px;
    transition: opacity 0.2s;
    align-self: flex-start;
    width: 100%;
    max-width: 285px;
    margin: 0 auto;
  }

  #{{ section.id }} .c-promo-button:hover {
    opacity: 0.9;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .c-promo-features {
      gap: 12px;
    }
    #{{ section.id }} .c-promo-feature-text {
      font-size: 14px;
    }
  }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-promo-section {
      padding: 56px 20px;
    }

    #{{ section.id }} .c-promo-wrap {
      padding: 44px 48px;
      min-height: 593px;
    }

    #{{ section.id }} .c-promo-body {
      align-items: flex-start;
      text-align: left;
    }

    #{{ section.id }} .c-promo-content {
      flex-direction: row;
      gap: 40px;
    }

    #{{ section.id }} .c-promo-image {
      max-width: 478px;
      height: 426px;
      margin: 0;
    }

    #{{ section.id }} .c-promo-image img,
    #{{ section.id }} .c-promo-image svg {
      height: 100%;
      object-fit: cover;
    }

    #{{ section.id }} .c-promo-image-badge {
      top: 20px;
      left: 20px;
      max-width: 168px;
    }

    #{{ section.id }} .c-promo-body {
      padding: 0;
      justify-content: center;
      max-width: 46.5%;
    }

    #{{ section.id }} .c-promo-heading {
      font-size: 56px;
      max-width: 439px;
    }

    #{{ section.id }} .c-promo-text {
      font-size: 18px;
    }

    #{{ section.id }} .c-promo-badge {
      top: 58px;
      left: 69px;
    }

    #{{ section.id }} .c-promo-badge-text {
      font-size: 24px;
    }

    #{{ section.id }} .c-promo-button {
      margin: 0;
    }
  }

  @media (min-width: 1224px) {
    #{{ section.id }} .c-promo-image {
      max-width: 558px;
      height: 506px;
    }

    #{{ section.id }} .c-promo-content {
      gap: 80px;
    }
  }
{% endstyle %}

