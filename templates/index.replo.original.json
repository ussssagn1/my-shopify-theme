      "blocks": {
        "16492625145307780a-0": {
          "type": "heading",
          "settings": {
            "heading": "How?",
            "heading_size": "h1"
          }
        },
        "16492625145307780a-1": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Step 1:</strong> Buy the dang thing</p><p><strong>Step 2:</strong> Pull your Monti Cooler out of it's integrated stuff sack</p><p><strong>Step 3:</strong> Fill with food, wine, an ice pack, your favorite drinks and go! </p><p><strong>Step 4: </strong>If you love it, send us your pictures and feedback to help improve our community. If you don't love it, send it back from a full refund. <br/> </p>"
          }
        }
      },
