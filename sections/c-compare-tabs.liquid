          },
          {
            "type": "richtext",
            "id": "block_paragraph3",
            "label": "Paragraph3",
            "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
          },
          {
            "type": "richtext",
            "id": "block_paragraph4",
            "label": "Paragraph4"
