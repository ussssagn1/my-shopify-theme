{% style %}
  #{{ section.id }}.c-header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: #192A3F;
    width: 100%;
    box-sizing: border-box;
    box-shadow: 0px 5px 15px 0px rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  #{{ section.id }} .c-header__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    height: 80px;
    box-sizing: border-box;
  }

  #{{ section.id }} .c-header__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  #{{ section.id }} .c-header__logo img {
    max-height: 60px;
    width: auto;
    display: block;
  }

  #{{ section.id }} .c-header__logo-text {
    font-family: sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #C13325;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }
{% endstyle %}

<header id="{{ section.id }}" class="c-header">
  <div class="c-header__inner">
    <a class="c-header__logo" href="/">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 300 | image_tag: loading: 'eager' }}
      {%- else -%}
        <span class="c-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  </div>
</header>

{% schema %}
{
  "name": "C Header Listicle",
  "settings": [],
  "presets": [
    {
      "name": "C Header Listicle"
    }
  ]
}
{% endschema %}
