{%- comment -%}
  Renders the custom Shop Pay installment widget + modal.
  Accepts:
  - product: {Object} product object
  - section_id: {String} section ID for unique element IDs
{%- endcomment -%}

<style>
  #{{ section_id }}.c-spw {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f9f8ff;
    border: 1px solid #d9dbe9;
    border-radius: 10px;
    overflow: hidden;
    margin: 12px 0;
  }
  #{{ section_id }} .c-spw__left {
    display: flex;
    align-items: stretch;
    align-self: stretch;
    flex-shrink: 0;
  }
  #{{ section_id }} .c-spw__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #5a31f4;
    border-radius: 7px;
    width: 80px;
    padding: 10px;
  }
  #{{ section_id }} .c-spw__right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    min-width: 0;
    padding: 6px 10px;
    gap: 8px;
  }
  #{{ section_id }} .c-spw__text {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: #000;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #{{ section_id }} .c-spw__amount {
    font-weight: 700;
  }
  #{{ section_id }} .c-spw__info-btn {
    display: flex;
    align-items: center;
    gap: 3px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #696969;
    font-family: Inter, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
    white-space: nowrap;
    flex-shrink: 0;
  }
  #{{ section_id }} .c-spw__info-btn:hover {
    color: #444;
  }
  #{{ section_id }} .c-spw__info-label {
    color: #696969;
  }

  /* ── Modal ── */
  #c-spw-modal-{{ section_id }} {
    position: fixed;
    inset: 0;
    margin: auto;
    width: 100%;
    max-width: 460px;
    padding: 20px;
    background: #fff;
    border: 1px solid #d9dbe9;
    border-radius: 10px;
    flex-direction: column;
    gap: 25px;
    z-index: 10000;
  }
  #c-spw-modal-{{ section_id }}::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }
  #c-spw-modal-{{ section_id }}[open] {
    display: flex;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__title-group {
    display: flex;
    align-items: center;
    gap: 7px;
    flex: 1;
    min-width: 0;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #5a31f4;
    border-radius: 5px;
    width: 33px;
    height: 33px;
    flex-shrink: 0;
    padding: 6px;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__title {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.55;
    color: #000;
    letter-spacing: -0.4px;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(217, 219, 233, 0.5);
    border: none;
    border-radius: 50%;
    width: 33px;
    height: 33px;
    flex-shrink: 0;
    cursor: pointer;
    padding: 6px;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__close:hover {
    background: rgba(217, 219, 233, 0.8);
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__desc {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: #696969;
    letter-spacing: -0.5px;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__desc strong {
    color: #000;
    font-weight: 700;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__divider {
    margin: 0;
    border: none;
    border-top: 1px solid #d9dbe9;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__benefits {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__benefit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 11px;
    flex: 1;
    min-width: 0;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__benefit-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #edecff;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
  }
  #c-spw-modal-{{ section_id }} .c-spw-modal__benefit-text {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: normal;
    color: #000;
    text-align: center;
  }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    #{{ section_id }} .c-spw__badge {
      width: 62px;
    }
    #{{ section_id }} .c-spw__text {
      font-size: 13px;
      white-space: normal;
    }
    #c-spw-modal-{{ section_id }} {
      max-width: calc(100% - 32px);
      padding: 16px;
    }
    #c-spw-modal-{{ section_id }} .c-spw-modal__title {
      font-size: 16px;
    }
  }

  @media (max-width: 439px) {
    #{{ section_id }} .c-spw__badge {
      width: 50px;
      padding: 5px;
    }
    #{{ section_id }} .c-spw__right {
      padding: 6px;
    }
    #{{ section_id }} .c-spw__text {
      font-size: 11px;
    }
    #{{ section_id }} .c-spw__info-btn {
      font-size: 13px;
    }
  }
</style>

