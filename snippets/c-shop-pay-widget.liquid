<script>
(function () {
  var sectionId = {{ section_id | json }};
  var widget = document.getElementById('c-spw-' + sectionId);
  var modal = document.getElementById('c-spw-modal-' + sectionId);
  if (!widget || !modal) return;

  var moneyFormat = widget.dataset.moneyFormat || '${{amount}}';

  function formatMoney(cents) {
    var amount = (cents / 100).toFixed(2);
    var amountNoDec = Math.round(cents / 100).toString();
    return moneyFormat
      .replace(/\{\{\s*amount\s*\}\}/g, amount)
      .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, amountNoDec)
      .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amount.replace('.', ','))
      .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, amountNoDec);
  }

  modal.addEventListener('click', function (e) {
    var rect = modal.getBoundingClientRect();
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      modal.close();
    }
  });

  if (typeof subscribe !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
    subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
      if (!event || !event.data || event.data.sectionId !== sectionId) return;
      var variant = event.data.variant;
      if (!variant || typeof variant.price === 'undefined') return;

      var installmentCents = Math.floor(variant.price / 4);
      var formatted = formatMoney(installmentCents);

      widget.querySelectorAll('.js-spw-amount').forEach(function (el) {
        el.textContent = formatted;
      });
      modal.querySelectorAll('.js-spw-modal-amount').forEach(function (el) {
        el.textContent = formatted;
      });
    });
  }
})();
</script>
