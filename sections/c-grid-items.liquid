{% style %}
  #{{ section.id }}.c-grid-items-section {
    padding: 30px 20px;
    background: #FFFFFF;
  }

  #{{ section.id }} .c-grid-items-container {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  #{{ section.id }} .c-grid-items-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  #{{ section.id }} .c-grid-items-heading {
    margin: 0;
    color: #000;
    text-align: center;
    font-family: "Inter";
    font-size: 44px;
    font-style: normal;
    font-weight: 700;
    line-height: 110%; 
    text-transform: uppercase;
  }

  #{{ section.id }} .c-grid-items-highlight {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  #{{ section.id }} .c-grid-items-highlight svg {
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  #{{ section.id }} .c-grid-items-text {
    margin: 0;
    color: #000;
    text-align: center;

    font-family: "Inter";
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 155%;
    letter-spacing: 0.6px;
  }

  #{{ section.id }} .c-grid-items-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #{{ section.id }} .c-grid-items-card {
    position: relative;
    border-radius: 12px;
    padding: 30px;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
  }

  #{{ section.id }} .c-grid-items-card-content {
    position: relative;
    z-index: 2;
    max-width: 65%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  #{{ section.id }} .c-grid-items-card-title {
    margin: 0;
    width: 100%;
    color: #253D4E;
    font-family: "Inter";
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 129%;
  }

  #{{ section.id }} .c-grid-items-card-btn {
    display: inline-block;
    background-color: #C13325;
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    padding: 6px 20px;
    border-radius: 6px;
    transition: background-color 0.3s ease;
  }

  #{{ section.id }} .c-grid-items-card-btn:hover {
    opacity: 0.9;
  }

  #{{ section.id }} .c-grid-items-card-img-wrap {
    position: absolute;
    top: 0;
    right: 0;
    max-width: 350px;
    width: 100%;
    height: 95%;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .c-grid-items-card-graphic {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
  }

  #{{ section.id }} .c-grid-items-card-img-wrap img,
  #{{ section.id }} .c-grid-items-card-img-wrap svg {
    width: 100%;
    height: 100%;
    object-fit: initial;
    display: block;
  }

  #{{ section.id }} .c-grid-items-card-img-wrap svg {
    background-color: #EFEFEF;
    border-radius: 8px 0 0 0;
  }

  @media(max-width: 450px) {
    #{{ section.id }} .c-grid-items-card-img-wrap {
      max-width: 180px;
      width: 100%;
    }

    #{{ section.id }} .c-grid-items-card {
      min-height: auto;
    }

    .c-grid-items-card-graphic {
      width: 80px;
      height: 80px;
    }
  }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-grid-items-section {
      padding: 56px 20px;
    }

    #{{ section.id }} .c-grid-items-header {
      gap: 24px;
    }

    #{{ section.id }} .c-grid-items-card-content {
      justify-content: space-between;
      height: 100%;
    }

    #{{ section.id }} .c-grid-items-heading {
      font-size: 56px;
    }

    #{{ section.id }} .c-grid-items-text {
      font-size: 18px;
    }

    #{{ section.id }} .c-grid-items-grid {
      flex-direction: row;
      justify-content: space-between;
    }

    #{{ section.id }} .c-grid-items-card {
      flex: 1;
      padding: 30px 23px;
      min-height: 237px;
    }

    #{{ section.id }} .c-grid-items-card-title {
      font-size: 20px;
    }

    #{{ section.id }} .c-grid-items-card-content {
      max-width: 90%;
      gap: 55px;
    }

    #{{ section.id }} .c-grid-items-card-img-wrap {
      max-width: 220px;
      height: auto;
      width: 50%;
      top: auto;
      bottom: 0;
    }

    #{{ section.id }} .c-grid-items-card-btn {
      max-width: 50%;
    }
  }

  @media (min-width: 1280px) {
    #{{ section.id }} .c-grid-items-card-content {
      max-width: 63%;
      gap: 55px;
    }

    #{{ section.id }} .c-grid-items-card-img-wrap {
      max-width: 245px;
      width: 55%;
      top: 0;
      bottom: auto;
    }

    #{{ section.id }} .c-grid-items-card-content {
      justify-content: flex-start;
    }

    #{{ section.id }} .c-grid-items-card-btn {
      max-width: none;
    }
  }
{% endstyle %}

