          "settings": {
            "heading": "Dimensions",
            "icon": "ruler",
            "content": "<p><strong>Mayfly: </strong>18\"H x 9\"W x 5\"D<br/>14 liter capacity<br/><br/><strong>Shasta: </strong>20\"H x 10\"W x 6.5\"D<br/>21 liter capacity<br/><br/><strong>Low Tide Tote: <br/> </strong>15\" wide x 8\" deep x 11.5\" tall (expandable to 14\" with extra top material)<strong>Capacity: </strong>About 25L</p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "<p><strong>Monti Guarantee</strong>: If you're not happy with your cooler return it unused for a full refund in the first 30 days!<br/><br/><strong>Holiday Gift Return:</strong>Unused coolers received as gifts, purchased after November 1st, can be returned until January 25th.<br/><br/><strong>Christmas Shipping Deadline:</strong>Order's placed on or before December 18th to the continental United States will ship out in time to arrive for Christmas.</p>",
            "page": ""
          }
        },
        "collapsible-row-3": {
