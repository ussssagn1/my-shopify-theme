</header>

<div class="c-header-overlay" id="c-header-overlay-{{ section.id }}"></div>

<div class="c-header-drawer" id="c-header-drawer-{{ section.id }}" aria-hidden="true" role="dialog" aria-label="Navigation">
  <div class="c-header-drawer__head">
    <a href="/" class="c-header__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 200 | image_tag: loading: 'lazy' }}
      {%- else -%}
        <span class="c-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <button type="button" class="c-header-drawer__close" aria-label="Close menu">
      <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M21 7L7 21M7 7l14 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  <hr class="c-header-drawer__divider">

  <div class="c-header-drawer__body">
    {%- if section.settings.badge_text != blank -%}
      <div class="c-header-drawer__badge-wrap">
        <a class="c-header-drawer__badge" href="{{ section.settings.badge_url | default: '#' }}">
          {{ section.settings.badge_text }}
        </a>
      </div>
    {%- endif -%}
    <hr class="c-header-drawer__divider">

    <nav class="c-header-drawer__nav">
      {%- for block in section.blocks -%}
        {%- assign has_submenu_mob = false -%}
        {%- if block.settings.products != blank or block.settings.menu != blank or block.settings.view_all_url != blank -%}
          {%- assign has_submenu_mob = true -%}
        {%- endif -%}

        <div class="c-header-drawer__item">
          <div class="c-header-drawer__item-row">
            {%- if has_submenu_mob -%}
              <a class="c-header-drawer__item-label" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
              <button
                type="button"
                class="c-header-drawer__item-arrow"
                data-sub-target="c-header-sub-{{ block.id }}"
                aria-expanded="false"
                aria-label="Open submenu"
              >
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- else -%}
              <a class="c-header-drawer__item-label" href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
            {%- endif -%}
          </div>
          <hr class="c-header-drawer__divider">
        </div>
      {%- endfor -%}
    </nav>

    {%- if section.settings.mobile_card_image != blank -%}
      <a class="c-header-drawer__card" href="{{ section.settings.mobile_card_url | default: '#' }}">
        {{ section.settings.mobile_card_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
        <div class="c-header-drawer__card-overlay"></div>
        <div class="c-header-drawer__card-content">
          {%- if section.settings.mobile_card_title != blank -%}
            <p class="c-header-drawer__card-title">{{ section.settings.mobile_card_title }}</p>
          {%- endif -%}
          <span class="c-header-drawer__card-btn">
            {{ section.settings.mobile_card_btn | default: 'Buy Now' }}
          </span>
        </div>
      </a>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- assign has_sub_panel = false -%}
    {%- if block.settings.products != blank or block.settings.menu != blank or block.settings.view_all_url != blank -%}
      {%- assign has_sub_panel = true -%}
    {%- endif -%}
    {%- if has_sub_panel -%}
      <div class="c-header-sub" id="c-header-sub-{{ block.id }}" aria-hidden="true" {{ block.shopify_attributes }}>
        <div class="c-header-sub__head">
          <button type="button" class="c-header-sub__back" aria-label="Back">
            <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18 6L10 14l8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <span class="c-header-sub__title">{{ block.settings.label }}</span>
          <button type="button" class="c-header-sub__close" aria-label="Close menu">
            <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21 7L7 21M7 7l14 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <hr class="c-header-drawer__divider">

        <div class="c-header-sub__body">
          {%- assign mob_products = block.settings.products -%}

          {%- if mob_products != blank and mob_products.size > 0 -%}
            {%- assign first_mob = mob_products | first -%}
            <a class="c-header-sub__product-full" href="{{ first_mob.url }}">
              <p class="c-header-sub__product-name">{{ first_mob.title }}</p>
              {%- if first_mob.featured_image != blank -%}
                {{ first_mob.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
              {%- endif -%}
              {%- if block.settings.first_product_badge -%}
                <span class="c-header-sub__badge">Best Seller</span>
              {%- endif -%}
            </a>
          {%- endif -%}

          {%- assign nav_menu_mob = linklists[block.settings.menu] -%}
          {%- assign has_second_row = false -%}
          {%- if mob_products.size > 1 or nav_menu_mob.links.size > 0 or block.settings.view_all_url != blank -%}
            {%- assign has_second_row = true -%}
          {%- endif -%}

          {%- if has_second_row -%}
            <div class="c-header-sub__row">
              {%- for prod in mob_products -%}
                {%- if forloop.index > 1 and forloop.index <= 4 -%}
                  <a class="c-header-sub__product-half" href="{{ prod.url }}">
                    <p class="c-header-sub__product-name">{{ prod.title }}</p>
                    {%- if prod.featured_image != blank -%}
                      {{ prod.featured_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
                    {%- endif -%}
                  </a>
                {%- endif -%}
              {%- endfor -%}

              {%- if nav_menu_mob.links.size > 0 or block.settings.view_all_url != blank -%}
                <div class="c-header-sub__links-col">
                  {%- if nav_menu_mob.links.size > 0 -%}
                    <ul class="c-header-sub__links-list">
                      {%- for link in nav_menu_mob.links -%}
                        <li><a href="{{ link.url }}">- {{ link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if block.settings.view_all_url != blank -%}
                    <a class="c-header-sub__view-all" href="{{ block.settings.view_all_url }}">
                      {{ block.settings.view_all_text | default: 'View All' }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

<script>
(function () {
  var sectionId = '{{ section.id }}';
  var header = document.getElementById(sectionId);
  var burger = document.getElementById('c-header-burger-' + sectionId);
  var drawer = document.getElementById('c-header-drawer-' + sectionId);
  var overlay = document.getElementById('c-header-overlay-' + sectionId);

  if (!header || !drawer) return;

  function openDrawer() {
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    if (overlay) overlay.classList.add('is-open');
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    if (overlay) overlay.classList.remove('is-open');
    closeAllSubs();
  }

  function closeAllSubs() {
    drawer.querySelectorAll('.c-header-sub.is-open').forEach(function (sub) {
      sub.classList.remove('is-open');
      sub.setAttribute('aria-hidden', 'true');
    });
  }

  if (burger) burger.addEventListener('click', openDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);

  drawer.querySelectorAll('.c-header-drawer__close, .c-header-sub__close').forEach(function (btn) {
    btn.addEventListener('click', closeDrawer);
  });

  drawer.querySelectorAll('[data-sub-target]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var targetId = this.getAttribute('data-sub-target');
      var sub = document.getElementById(targetId);
      if (sub) {
        sub.classList.add('is-open');
        sub.setAttribute('aria-hidden', 'false');
      }
    });
  });

  drawer.querySelectorAll('.c-header-sub__back').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var sub = btn.closest('.c-header-sub');
      if (sub) {
        sub.classList.remove('is-open');
        sub.setAttribute('aria-hidden', 'true');
      }
    });
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
  });

  document.addEventListener('shopify:section:unload', function (e) {
    if (e.detail && e.detail.sectionId === sectionId) closeDrawer();
  });

  var lastScroll = 0;
  var ticking = false;
  var headerHeight = header.offsetHeight;

  function updateHeader() {
    var currentScroll = window.pageYOffset;
    
    if (currentScroll <= 0) {
      header.style.position = 'sticky';
      header.style.top = '0';
      header.style.transform = 'translateY(0)';
      header.style.transition = 'none';
    } else if (currentScroll < lastScroll) {
      header.style.position = 'fixed';
      header.style.top = '0';
      header.style.transform = 'translateY(0)';
      header.style.transition = 'transform 0.25s ease';
    } else {
      header.style.position = 'fixed';
      header.style.transform = 'translateY(-100%)';
      header.style.transition = 'transform 0.25s ease';
    }

    lastScroll = currentScroll;
    ticking = false;
  }

  window.addEventListener('scroll', function () {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });

  updateHeader();
})();
</script>

