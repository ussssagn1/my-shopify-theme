{% style %}
  #{{ section.id }}.c-ss-promo-section {
    padding: 30px 20px;
  }

  #{{ section.id }} .c-ss-promo-wrap {
    max-width: 1384px;
    margin: 0 auto;
    background: #FF8D69;
    border-radius: 25px;
    padding: 40px 20px;
    position: relative;
    overflow: hidden;
  }

  #{{ section.id }} .c-ss-promo-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  #{{ section.id }} .c-ss-promo-media {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    position: relative;
  }

  #{{ section.id }} .c-ss-promo-image {
    width: 100%;
    border: 1px solid #FFFFFF;
    border-radius: 16px;
    overflow: hidden;
    background: #D9D9D9;
  }

  #{{ section.id }} .c-ss-promo-image img,
  #{{ section.id }} .c-ss-promo-image svg {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  #{{ section.id }} .c-ss-promo-sale-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 122px;
    height: 122px;
    z-index: 3;
    pointer-events: none;
  }

  #{{ section.id }} .c-ss-promo-sale-badge-inner {
    width: 100px;
    height: 100px;
    position: absolute;
    top: 10px;
    left: 10px;
    transform: rotate(-15deg);
  }

  #{{ section.id }} .c-ss-promo-sale-badge-inner img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  #{{ section.id }} .c-ss-promo-sale-badge-text {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -42%) rotate(-15deg);
    margin: 0;
    width: 52px;
    font-family: "Inter", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.6px;
    text-align: center;
    color: #000000;
    text-transform: uppercase;
  }

  #{{ section.id }} .c-ss-promo-body {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 40px;
  }

  #{{ section.id }} .c-ss-promo-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: #000000;
  }

  #{{ section.id }} .c-ss-promo-heading {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1.68px;
    color: #000000;
  }

  #{{ section.id }} .c-ss-promo-text {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #000000;
  }

  #{{ section.id }} .c-ss-promo-features {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  #{{ section.id }} .c-ss-promo-feature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    border-radius: 60px;
    background: rgba(250, 250, 245, 0.7);
  }

  #{{ section.id }} .c-ss-promo-feature-icon {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-ss-promo-feature-icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  #{{ section.id }} .c-ss-promo-feature-text {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #000000;
    white-space: nowrap;
  }

  #{{ section.id }} .c-ss-promo-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 285px;
    padding: 12px 24px;
    border-radius: 10px;
    background: #FFFFFF;
    color: #111111;
    text-align: center;
    text-decoration: none;
    font-family: "Inter", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.55;
    letter-spacing: 0.6px;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    margin: 0 auto;
  }

  #{{ section.id }} .c-ss-promo-button:hover {
    opacity: 0.9;
  }

  #{{ section.id }} .c-ss-promo-top-right {
    position: absolute;
    width: 120px;
    top: 8px;
    right: 4px;
    height: auto;
    z-index: 1;
    pointer-events: none;
    transform: scaleX(-1);
    transform-origin: center;
  }

  #{{ section.id }} .c-ss-promo-bottom-flowers {
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 420px;
    height: auto;
    z-index: 1;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .c-ss-promo-features {
      gap: 12px;
    }

    #{{ section.id }} .c-ss-promo-feature-text {
      font-size: 14px;
    }
  }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-ss-promo-section {
      padding: 56px 20px;
    }

    #{{ section.id }} .c-ss-promo-wrap {
      padding: 44px 48px;
      min-height: 593px;
    }

    #{{ section.id }} .c-ss-promo-content {
      flex-direction: row;
      align-items: center;
      gap: 40px;
    }

    #{{ section.id }} .c-ss-promo-media {
      max-width: 478px;
      flex: 0 0 478px;
      margin: 0;
    }

    #{{ section.id }} .c-ss-promo-image {
      height: 426px;
    }

    #{{ section.id }} .c-ss-promo-image img,
    #{{ section.id }} .c-ss-promo-image svg {
      height: 100%;
    }

    #{{ section.id }} .c-ss-promo-sale-badge {
      top: 20px;
      left: 20px;
      width: 162px;
      height: 162px;
    }

    #{{ section.id }} .c-ss-promo-sale-badge-inner {
      width: 132px;
      height: 132px;
      top: 15px;
      left: 15px;
    }

    #{{ section.id }} .c-ss-promo-sale-badge-text {
      width: 70px;
      font-size: 24px;
    }

    #{{ section.id }} .c-ss-promo-body {
      align-items: flex-start;
      text-align: left;
      max-width: 46.5%;
      gap: 40px;
    }

    #{{ section.id }} .c-ss-promo-heading {
      font-size: 56px;
      max-width: 439px;
    }

    #{{ section.id }} .c-ss-promo-text {
      font-size: 18px;
      max-width: 510px;
    }

    #{{ section.id }} .c-ss-promo-features {
      justify-content: flex-start;
      max-width: 539px;
    }

    #{{ section.id }} .c-ss-promo-button {
      width: 285px;
      max-width: 285px;
      height: 60px;
      padding: 16px 63px;
      border-radius: 16px;
      font-size: 20px;
      font-weight: 600;
      line-height: 1.29;
      letter-spacing: 0;
      margin: 0;
    }

    #{{ section.id }} .c-ss-promo-top-right {
      width: 201px;
      top: 16px;
      right: 0;
    }

    #{{ section.id }} .c-ss-promo-bottom-flowers {
      width: 736px;
      bottom: -10px; 
      z-index: 3;
    }
  }

  @media (min-width: 1224px) {
    #{{ section.id }} .c-ss-promo-content {
      gap: 80px;
    }

    #{{ section.id }} .c-ss-promo-media {
      max-width: 558px;
      flex-basis: 558px;
    }

    #{{ section.id }} .c-ss-promo-image {
      height: 506px;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="c-ss-promo-section">
  <div class="c-ss-promo-wrap">
    <img
      class="c-ss-promo-top-right"
      src="https://www.figma.com/api/mcp/asset/2896b3e7-a340-40a0-8af9-a08760fdee31"
      alt=""
      loading="lazy"
      aria-hidden="true"
    >

    {%- if section.settings.bottom_left_flowers_image != blank -%}
      {{ section.settings.bottom_left_flowers_image | image_url: width: 1600 | image_tag: class: 'c-ss-promo-bottom-flowers', loading: 'lazy', widths: '400, 736, 1100, 1600', alt: '' }}
    {%- else -%}
      <svg class="c-ss-promo-bottom-flowers" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 736 263" fill="none" aria-hidden="true">
        <g>
          <path d="M39 262C59 201 84 190 117 233" stroke="#2E646D" stroke-width="3.8" stroke-linecap="round"/>
          <path d="M72 262C79 222 103 196 132 214" stroke="#2E646D" stroke-width="3.8" stroke-linecap="round"/>
          <ellipse cx="40" cy="36" rx="39.5" ry="38.5" transform="matrix(-1 0 0 1 120 172)" fill="#F7B8C8"/>
          <ellipse cx="40.5" cy="38" rx="40.5" ry="38" transform="matrix(-1 0 0 1 156 171)" fill="#F8C3D0"/>
          <ellipse cx="40.5" cy="38" rx="40.5" ry="38" transform="matrix(-1 0 0 1 135 143)" fill="#F4A6BC"/>
          <ellipse cx="39.5" cy="37" rx="39.5" ry="37" transform="matrix(-1 0 0 1 132 201)" fill="#F7B7C9"/>
          <ellipse cx="16.5" cy="15.5" rx="16.5" ry="15.5" transform="matrix(-1 0 0 1 110 177)" fill="#FFE6BF"/>
          <path d="M74 173C86 150 111 150 123 173" stroke="#FCE4EE" stroke-width="2.2" stroke-linecap="round"/>
          <path d="M86 156C98 138 117 138 126 157" stroke="#FCE4EE" stroke-width="2.2" stroke-linecap="round"/>
          <path d="M255 262C264 246 277 238 294 247" stroke="#74A63D" stroke-width="4" stroke-linecap="round"/>
          <circle cx="255" cy="249" r="4.5" fill="#FEB100"/>
          <circle cx="270" cy="242" r="3.8" fill="#FEB100"/>
          <circle cx="285" cy="246" r="4" fill="#FEB100"/>
          <path d="M296 262C314 230 341 224 373 253" stroke="#5E8843" stroke-width="4.8" stroke-linecap="round"/>
          <ellipse cx="33" cy="31" rx="33" ry="31" transform="matrix(-1 0 0 1 430 167)" fill="#FEB100"/>
          <ellipse cx="34" cy="31" rx="34" ry="31" transform="matrix(-1 0 0 1 470 170)" fill="#E88F00"/>
          <ellipse cx="34" cy="32" rx="34" ry="32" transform="matrix(-1 0 0 1 451 137)" fill="#FEE136"/>
          <ellipse cx="34" cy="31" rx="34" ry="31" transform="matrix(-1 0 0 1 448 199)" fill="#F4A000"/>
          <ellipse cx="14" cy="13.5" rx="14" ry="13.5" transform="matrix(-1 0 0 1 430 171)" fill="#FCEB86"/>
          <path d="M401 164C412 149 428 149 437 164" stroke="#F0B241" stroke-width="2" stroke-linecap="round"/>
          <path d="M412 150C421 139 435 139 442 151" stroke="#F0B241" stroke-width="2" stroke-linecap="round"/>
          <path d="M603 262V203" stroke="#71A33D" stroke-width="3.8" stroke-linecap="round"/>
          <path d="M603 230C618 230 629 239 629 262" stroke="#71A33D" stroke-width="3.8" stroke-linecap="round"/>
          <path d="M603 229C585 229 575 240 575 262" stroke="#71A33D" stroke-width="3.8" stroke-linecap="round"/>
          <ellipse cx="606.5" cy="194.5" rx="12.5" ry="12.5" fill="#FFFFFF"/>
          <ellipse cx="591" cy="197" rx="11" ry="10" fill="#FFFFFF"/>
          <ellipse cx="621" cy="197" rx="11" ry="10" fill="#FFFFFF"/>
          <ellipse cx="606" cy="208" rx="10.5" ry="10" fill="#FFFFFF"/>
          <ellipse cx="606" cy="197" rx="4.5" ry="4" fill="#F4C24B"/>
        </g>
      </svg>
    {%- endif -%}

    <div class="c-ss-promo-content">
      <div class="c-ss-promo-media">
        <div class="c-ss-promo-image">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400' }}
          {%- else -%}
            <img
              src="https://www.figma.com/api/mcp/asset/ce39ca75-ef65-48ac-bd75-3759845ef632"
              alt=""
              loading="lazy"
            >
          {%- endif -%}
        </div>

        <div class="c-ss-promo-sale-badge">
          <div class="c-ss-promo-sale-badge-inner">
            <img src="https://www.figma.com/api/mcp/asset/81ab372d-e69d-4a5f-8cd2-cb66cb90a648" alt="" loading="lazy" aria-hidden="true">
          </div>
          <p class="c-ss-promo-sale-badge-text">{{ section.settings.sale_badge_text | newline_to_br }}</p>
        </div>
      </div>

      <div class="c-ss-promo-body">
        <div class="c-ss-promo-copy">
          {%- if section.settings.heading != blank -%}
            <h2 class="c-ss-promo-heading">{{ section.settings.heading | newline_to_br }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <p class="c-ss-promo-text">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>

        {%- assign ss_fallback_feature_icons = "https://www.figma.com/api/mcp/asset/e81a91e5-bd73-40c7-bc3c-2ca3dfd75938|https://www.figma.com/api/mcp/asset/63bb0e9b-4c0a-4990-943c-8675d9849dd5|https://www.figma.com/api/mcp/asset/8a8f82ae-1b30-4cb0-969f-28b88f2eea2f|https://www.figma.com/api/mcp/asset/928ba667-f738-4887-ae47-4879eea98917" | split: "|" -%}
        {%- if section.blocks.size > 0 -%}
          <div class="c-ss-promo-features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' and block.settings.text != blank -%}
                {%- assign ss_fallback_icon = ss_fallback_feature_icons[forloop.index0] -%}
                <div class="c-ss-promo-feature" {{ block.shopify_attributes }}>
                  <span class="c-ss-promo-feature-icon" aria-hidden="true">
                    {%- if block.settings.icon != blank -%}
                      {{ block.settings.icon | image_url: width: 36 | image_tag: loading: 'lazy' }}
                    {%- elsif ss_fallback_icon != blank -%}
                      <img src="{{ ss_fallback_icon }}" alt="" loading="lazy">
                    {%- endif -%}
                  </span>
                  <span class="c-ss-promo-feature-text">{{ block.settings.text }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="c-ss-promo-button">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "C SS Promo Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "bottom_left_flowers_image",
      "label": "Bottom left flowers image"
    },
    {
      "type": "textarea",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "SAVE\\n20%"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Save 20% OFF\\nOn All Coolers."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Don't wait for summer, grab exclusive savings on our packable, portable coolers and get back into the wild."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Buy Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "C SS Promo Banner",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "Everyday Living"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Effortless to Use"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Sustainable"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Minimalist Aesthetic"
          }
        }
      ]
    }
  ]
}
{% endschema %}
