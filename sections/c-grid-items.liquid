<section id="{{ section.id }}" class="c-grid-items-section">
  <div class="c-grid-items-container">

    <div class="c-grid-items-header">
      {% if section.settings.heading != blank %}
        {%- assign heading_parts = section.settings.heading | split: '[' -%}
        {%- assign parsed_heading = heading_parts[0] -%}
        {%- if heading_parts.size > 1 -%}
          {%- assign rest_of_heading = heading_parts[1] | split: ']' -%}
          {%- assign parsed_heading = parsed_heading | append: '<span class="c-grid-items-highlight">' | append: rest_of_heading[0] | append: svg_underline | append: '</span>' | append: rest_of_heading[1] -%}
        {%- endif -%}
        
        <h2 class="c-grid-items-heading">{{ parsed_heading }}</h2>
      {% endif %}
      
      {% if section.settings.text != blank %}
        <p class="c-grid-items-text">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="c-grid-items-grid">
        {% for block in section.blocks %}
          <div class="c-grid-items-card" style="background-color: {{ block.settings.bg_color }};">
            
            <div class="c-grid-items-card-content">
              {% if block.settings.title != blank %}
                <h3 class="c-grid-items-card-title">{{ block.settings.title }}</h3>
              {% endif %}
              
              {% if block.settings.button_text != blank and block.settings.button_url != blank %}
                <a href="{{ block.settings.button_url }}" class="c-grid-items-card-btn">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>

            <div class="c-grid-items-card-img-wrap">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>

            {% if block.settings.use_graphic %}
              <svg class="c-grid-items-card-graphic" xmlns="http://www.w3.org/2000/svg" width="118" height="107" viewBox="0 0 118 107" fill="none">
                <path d="M191.368 82.1272C180.643 94.6392 164.854 102.683 148.767 105.364C141.32 106.555 133.872 106.853 126.424 105.513C119.424 104.321 112.423 101.193 106.167 97.7672C103.188 96.1288 100.358 94.1924 97.6764 92.256C94.2505 89.7238 90.8246 87.1916 87.6966 84.3615C81.7385 78.8503 77.8657 71.2537 75.3335 63.6571C72.6524 55.6137 71.4608 47.1234 71.0139 38.782C70.5671 29.5469 70.8649 19.865 72.6524 10.7789C74.5888 1.3949 79.2063 -7.5423 87.3987 -12.9046C94.5484 -17.5221 103.486 -18.1179 110.933 -13.7983C117.636 -9.92551 122.403 -2.9248 124.488 4.37388C126.722 12.4173 125.382 20.7587 121.36 28.0574C112.87 43.3995 94.5484 52.4856 77.8657 55.3157C69.2265 56.8053 59.9914 56.8053 51.5011 54.1241C42.415 51.1451 35.1163 45.1869 29.903 37.1435C24.3917 28.5042 20.9658 18.5244 17.6888 8.99147C14.114 -1.28627 10.986 -11.713 8.60272 -22.2886C3.68729 -43.2909 0.857193 -64.8891 0.112427 -86.4873C-0.0365143 -91.8496 -0.0365143 -97.0628 0.112427 -102.425C0.261383 -107.192 7.70903 -107.192 7.56007 -102.425C6.66637 -62.2079 13.6671 -21.9908 27.9666 15.5453C31.0946 23.7377 34.5205 32.526 40.6275 38.9309C45.9898 44.5911 53.2885 47.7191 60.8851 48.6129C68.9286 49.5066 77.121 48.4639 84.7175 46.0806C92.0162 43.8463 99.3149 40.4205 105.273 35.505C111.082 30.7385 115.849 24.6315 117.636 17.1839C119.126 11.0768 117.338 4.225 113.912 -1.1373C110.486 -6.20169 105.273 -9.77661 99.3149 -9.47871C91.8673 -9.03185 86.0581 -2.92477 82.9301 3.4802C78.9084 11.6726 78.7595 21.6525 78.4616 30.5896C78.3126 37.8883 78.9084 45.3359 80.249 52.6346C81.7385 59.7843 83.9728 66.934 87.9945 73.19C91.8673 79.1481 97.9743 83.3189 103.635 87.4895C108.997 91.3623 114.955 94.1924 121.211 96.4267C127.02 98.661 132.531 99.1078 138.787 98.9588C152.64 98.512 167.088 93.4476 178.111 84.6594C181.09 82.2762 183.622 79.744 186.154 76.9139C187.495 75.4243 190.027 75.5733 191.368 76.9139C192.857 78.4034 192.708 80.6377 191.368 82.1272Z" fill="white"/>
