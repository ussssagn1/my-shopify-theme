                  </svg>
                  <svg class="c-sale-star" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M6.24778 0.371783C6.49408 -0.123938 7.20123 -0.123938 7.44753 0.371783L9.05252 3.60208C9.15006 3.79839 9.33747 3.93455 9.55431 3.96665L13.1225 4.49487C13.67 4.57593 13.8886 5.24847 13.4932 5.6359L10.917 8.16055C10.7604 8.31398 10.6888 8.5343 10.7253 8.75044L11.3256 12.3072C11.4177 12.853 10.8456 13.2687 10.355 13.0124L7.15778 11.3424C6.96348 11.2409 6.73183 11.2409 6.53754 11.3424L3.34035 13.0124C2.84971 13.2687 2.27761 12.853 2.36973 12.3072L2.96999 8.75044C3.00647 8.5343 2.93488 8.31398 2.77832 8.16055L0.202093 5.6359C-0.193254 5.24847 0.0252689 4.57593 0.572839 4.49487L4.14101 3.96665C4.35784 3.93455 4.54526 3.79839 4.64279 3.60208L6.24778 0.371783Z" fill="#FF9500"/>
                  </svg>
                </div>
