{% style %}
  #{{ section.id }}.c-preview {
    background-color: rgba(25, 42, 63, 1);
    padding-bottom: 35px;
  }

  #{{ section.id }} .c-prev {
    background: #0E1120;
    padding: 50px 19px;
    box-sizing: border-box;
    width: 100%;
  }

  #{{ section.id }} .c-prev-inner {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
  }

  #{{ section.id }} .c-prev-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    height: 772px;
  }

  #{{ section.id }} .c-prev-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #{{ section.id }} .c-prev-img--desktop { display: none; }

  #{{ section.id }} .c-prev-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.7) 28%, rgba(0, 0, 0, 0) 85%);
  }

  #{{ section.id }} .c-prev-content {
    position: absolute;
    left: 33px;
    top: 32px;
    max-width: calc(100% - 66px);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  #{{ section.id }} .c-prev-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #{{ section.id }} .c-prev-heading {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 36px;
    line-height: 1.1;
    color: #fff;
    margin: 0;
  }

  #{{ section.id }} .c-prev-body {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #fff;
  }

  #{{ section.id }} .c-prev-body p { margin: 0; }

  #{{ section.id }} .c-prev-body strong { font-weight: 700; }

  #{{ section.id }} .c-prev-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 60px;
    border-radius: 10px;
    border: 2px solid #fe8585;
    background: linear-gradient(90deg, #c5200f 38.46%, #e14b3c 100%);
    box-shadow: 0 0 3px #ff5252, inset 0 0 26px 0 #ff7d7d;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.29;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }

  #{{ section.id }} .c-prev-btn:hover { opacity: 0.88; }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-preview {
      padding-bottom: 60px;
    }

    #{{ section.id }} .c-prev {
      padding: 80px 60px;
    }

    #{{ section.id }} .c-prev-card {
      height: 479px;
    }

    #{{ section.id }} .c-prev-overlay {
      background: linear-gradient(90deg, rgba(25, 42, 63, 0.8) 5%, rgba(25, 42, 63, 0) 77%);
    }

    #{{ section.id }} .c-prev-content {
      left: 61px;
      top: 50%;      
      transform: translateY(-50%);
      max-width: 583px;
    }

    #{{ section.id }} .c-prev-heading {
      font-size: 44px;
      text-transform: uppercase;
      letter-spacing: 0px;
    }

    #{{ section.id }} .c-prev-btn {
      width: fit-content;
      padding: 0 40px;
    }

    #{{ section.id }} .c-prev-img--mobile { display: none; }
    #{{ section.id }} .c-prev-img--desktop { display: block; }
  }
{% endstyle %}

<section id="{{ section.id }}" class="c-preview">
  <div class="c-prev">
    <div class="c-prev-inner">
      <div class="c-prev-card">

        {% if section.settings.mobile_background_image != blank %}
          {{
            section.settings.mobile_background_image
            | image_url: width: 1000
            | image_tag:
              class: 'c-prev-img c-prev-img--mobile',
              loading: 'lazy',
              alt: ''
          }}
          {{
            section.settings.background_image
            | image_url: width: 2000
            | image_tag:
              class: 'c-prev-img c-prev-img--desktop',
              loading: 'lazy',
              alt: ''
          }}
        {% elsif section.settings.background_image != blank %}
          {{
            section.settings.background_image
            | image_url: width: 2000
            | image_tag:
              class: 'c-prev-img',
              loading: 'lazy',
              alt: ''
          }}
        {% endif %}

        <div class="c-prev-overlay"></div>

        <div class="c-prev-content">

          <div class="c-prev-text">
            {% if section.settings.heading != blank %}
              <h2 class="c-prev-heading">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.body_text != blank %}
              <div class="c-prev-body">{{ section.settings.body_text }}</div>
            {% endif %}
          </div>

          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_url }}" class="c-prev-btn">
              {{ section.settings.button_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M5 12H19M13 6L19 12L13 18" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}

        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "C Listicle Preview",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Background image (mobile)",
      "info": "If left empty, the desktop image is used on mobile too"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Go Lighter?"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Free shipping on orders <strong>over $160<\/strong>. 30-day returns if you don't love it.<\/p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Buy the Shasta"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "C Listicle Preview",
      "settings": {
        "heading": "Ready to Go Lighter?",
        "body_text": "<p>Free shipping on orders <strong>over $160<\/strong>. 30-day<br> returns if you don't love it.<\/p>",
        "button_text": "Buy the Shasta"
      }
    }
  ]
}
{% endschema %}
