{% style %}
  #{{ section.id }}.c-listicle-announcement {
    background-color: {{ section.settings.bg_color }};
    width: 100%;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0 52px;
    box-sizing: border-box;
  }

  #{{ section.id }}.c-listicle-announcement img {
    display: inline-block;
    vertical-align: middle;
    width: 18px;
    height: 18px;
  }

  #{{ section.id }} .c-listicle-announcement__text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.15;
    color: #fff;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 5px;
  }

  #{{ section.id }} .c-listicle-announcement__close {
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
    flex-shrink: 0;
  }

  @media screen and (min-width: 1024px) {
    #{{ section.id }}.c-listicle-announcement {
      padding: 0 64px;
    }
  }
{% endstyle %}

<div id="{{ section.id }}" class="c-listicle-announcement">
  {%- if section.settings.text != blank -%}
    {%- if section.settings.icon != blank -%}
      {{ section.settings.icon | image_url: width: 100 | image_tag: loading: 'lazy', height: 'auto' }}
      {{ section.settings.icon | image_url: width: 100 | image_tag: loading: 'lazy', height: 'auto' }}
    {%- endif -%}
    <p class="c-listicle-announcement__text">{{ section.settings.text }}</p>
    {%- if section.settings.icon != blank -%}
      {{ section.settings.icon | image_url: width: 100 | image_tag: loading: 'lazy', height: 'auto' }}
      {{ section.settings.icon | image_url: width: 100 | image_tag: loading: 'lazy', height: 'auto' }}
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_close -%}
    <button type="button" class="c-listicle-announcement__close" aria-label="Close announcement">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13 1L1 13" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M1 1L13 13" stroke="white" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  {%- endif -%}
</div>

<script>
(function () {
  var sectionId = '{{ section.id }}';
  var bar = document.getElementById(sectionId);
  if (!bar) return;

  var closeBtn = bar.querySelector('.c-listicle-announcement__close');
  if (!closeBtn) return;

  closeBtn.addEventListener('click', function () {
    bar.style.display = 'none';
  });
})();
</script>

{% schema %}
{
  "name": "Listicle Announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "FREE SHIPPING over $160"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E43C32"
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show Close Button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Listicle Announcement"
    }
  ]
}
{% endschema %}
