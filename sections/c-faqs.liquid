<style>
  #{{ section.id }} {
    font-size: 16px;
    padding-top: {{ section.settings.padding_top }}em;
    padding-bottom: {{ section.settings.padding_bottom }}em;
    background-color: {{ section.settings.bg_color }};
  }

  #{{ section.id }} div,
  #{{ section.id }} h3 {
    color: {{ section.settings.text_color }};
  }

  #{{ section.id }} .c-section-top {
    align-items: {{ section.settings.section_top_alignment }};
    text-align: {{ section.settings.text_alignment }};
  }

  #{{ section.id }} .c-f-filters {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background-color: #F1F1F1;
    max-width: 885px;
    margin: 0 auto 35px;
    border-radius: 10px;
  }

  #{{ section.id }} .c-f-filter {
    border-radius: 10px;
    cursor: pointer;
    letter-spacing: 0;
    padding: 4px 14px;
    text-align: center;
  }

  #{{ section.id }} .c-f-filter.c-category-active {
    color: {{ section.settings.accent_color }};
    background-color: #fff;
  }
  

  #{{ section.id }} .c-f-grid {
    {% if section.settings.use_grid == true %}
      display: grid;
      grid-template-columns: 0.75fr 1fr;
    {% else %}
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
    {% endif %}
    gap: 4em;
  }

  #{{ section.id }} .c-f-grid-right {
    {% if section.settings.side == true %}grid-row: 1;{% endif %}
  }

  #{{ section.id }} .c-f-grid-right-inner,
  #{{ section.id }} .c-buttons-div {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    flex-direction: column;
    gap: 1em;
  }

  #{{ section.id }} .c-buttons-div {
    justify-content: center;
    align-items: center;
    margin-top: 3em;
  }

  #{{ section.id }} .c-f-grid-right-inner {
    position: sticky;
    top: var(--sticky-top);
  }

  #{{ section.id }} .c-f-grid-left {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    {% if section.settings.use_grid == false %}
      min-width: 700px;
      max-width: 700px;
    {% endif %}
  }

  @media (min-width: {{ settings.c_breakpoint2 }}px) {
    #{{ section.id }} .c-f-grid-left {
      max-width: 830px;
      min-width: 830px;
    }
  }

  #{{ section.id }} .c-f-card {
    border: 1px solid #ccc;
    background: {{ section.settings.card_bg }};
    padding: 1.25em 1.5em 0.25em 1.5em;
    border-radius: 7px;
    cursor: pointer;
    display: none;
    transition: 0.2s ease;
    font-size: 20px;
  }

  #{{ section.id }} .c-f-card:hover {
    border-color: #000;
  }

  #{{ section.id }} .c-f-card.c-category-active {
    display: block;
  }

  #{{ section.id }} .c-f-card:hover {
    border-color: {{ section.settings.text_color }};
  }

  #{{ section.id }} .c-f-card-top {
    display: flex;
    justify-content: space-between;
  }

  #{{ section.id }} .c-f-card-top p {
    font-weight: 600;
    line-height: 140%;
  }

  #{{ section.id }} .c-f-card-top p,
  #{{ section.id }} .c-f-answer p,
  #{{ section.id }} .c-f-plus-div svg {
    color: {{ section.settings.faq_text_border }};
  }

  #{{ section.id }} .c-f-plus-div {
    padding-left: 5px;
    border-radius: 0px;
    margin: auto 0px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #{{ section.id }} .c-f-plus-div svg {
    width: 0.75em;
    height: 0.75em;
    transition: 0.3s ease;
  }

  #{{ section.id }} .c-f-answer {
    margin-top: 20px;
  }
    
  #{{ section.id }} .c-f-answer {
    
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.9s ease, padding 0.8s ease;
    padding-top: 0;
    padding-bottom: 0;
    
  }

  #{{ section.id }} .c-f-answer > * {
    color: {{ section.settings.faq_text_border }};
  }

  #{{ section.id }} .c-f-answer a {
    text-decoration: underline;
    color: {{ section.settings.faq_text_border }};
  }

  #{{ section.id }} .c-f-active .c-f-answer {
    display: block;
    max-height: 1000px;  
    transition: max-height 0.9s ease, padding 0.8s ease;
    padding-top:0px; 
    padding-bottom:12px;
  }

  #{{ section.id }} .c-f-active .c-f-plus-div svg {
    transform: rotate(180deg);
  }




  @media (max-width: {{ settings.c_breakpoint3 }}px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 }}em;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 }}em;
    }

    #{{ section.id }} .c-f-filters {
      flex-direction: column;
      display: block;
      text-align: center;
      margin: 0 auto 20px;
    }

    #{{ section.id }} .c-f-filter {
      display: inline-flex;
      font-size: 14px;
      padding: 4px 8px;
    }

    {% if section.settings.use_grid == true %}
      #{{ section.id }} .c-f-grid {
        grid-template-columns: 1fr;
      }

    {% else %}

      #{{ section.id }} .c-f-grid-left {
        min-width: auto;
        width: 100%;
      }
    {% endif %}

    #{{ section.id }} .c-f-card {
      padding: 1.25em 1.25em 0.25em 1.25em;
      font-size: 16px;
    }

    #{{ section.id }} .c-f-grid-left {
      max-width: 100% !important;
      min-width: 100% !important;
    }
  }
</style>


{%- assign filterBlocks = section.blocks | where: 'type', 'Filter' -%}


<section id="{{ section.id }}" class="c-section">
  <div class="page-width">
    <div class="c-section-top">
      {%- if section.settings.section_top_subheading != empty -%}<p class="c-section-top-subheading">{{ section.settings.section_top_subheading }}</p>{%- endif -%}
      {%- if section.settings.section_top_heading != empty -%}<h2>{{ section.settings.section_top_heading }}</h2>{%- endif -%}
      {%- if section.settings.section_top_paragraph != empty -%}<div class="c-t-80">{{ section.settings.section_top_paragraph }}</div>{%- endif -%}
    </div>
    <div class="c-f-filters">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'Filter' %}
            <div data-filter="{{ block.settings.filter_text | handleize }}" class="c-f-filter {% if forloop.first %}c-category-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.filter_text }}</div>
            {% if forloop.first %}{% assign firstCategory = block.settings.filter_text | handleize %}{% endif %}
        {% endcase %}
      {% endfor %}
    </div>
    <div class="c-f-grid">
      <div class="c-f-grid-left">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'Item' %}
              {% assign cardFirstCategory = block.settings.faq_category | handleize %}
              <div data-filter-{{ block.settings.faq_category | handleize }} class="c-f-card {% if cardFirstCategory == firstCategory %}c-category-active{% endif %} {% if forloop.first %}c-active{% endif %}" {{ block.shopify_attributes }}>
                <div class="c-f-card-top">
                  <p>{{ block.settings.faq_heading }}</p>
                  <div class="c-f-plus-div">{% render 'c-icon-chevron' %}</div>
                </div>
                <div class="c-f-answer">{{ block.settings.faq_answer }}</div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
      {% if section.settings.use_grid == true %}
        <div class="c-f-grid-right">
          <div class="c-f-grid-right-inner">
            <h2 class="c-f-heading">{{ section.settings.heading }}</h2>
            <div class="c-f-para">{{ section.settings.paragraph }}</div>
            {%- if section.settings.button_text != empty -%}
              <a class="c-button {{ section.settings.button_style }}" href="{{ section.settings.button_url }}">{{ section.settings.button_text }}</a>
            {%- endif -%}
          </div>
        </div>
      {% endif %}
    </div>
    {% if section.settings.use_grid == false %}
      {%- if section.settings.button_text != empty -%}
        <div class="c-buttons-div">
          <a class="c-button c-b1" href="{{ section.settings.button_url }}">{{ section.settings.button_text }}</a>
        </div>
      {%- endif -%}
    {% endif %}
  </div>
</section>


<script>
  document.querySelectorAll("#{{ section.id }} .c-f-card").forEach(faq => {
    faq.addEventListener("click", () => {
      if (faq.classList.contains("c-f-active")) {
        document.querySelectorAll("#{{ section.id }} .c-f-card").forEach(faq2 => {
          faq2.classList.remove("c-f-active");
        });
        faq.classList.remove("c-f-active");
      } else {
        document.querySelectorAll("#{{ section.id }} .c-f-card").forEach(faq2 => {
          faq2.classList.remove("c-f-active");
        });
        faq.classList.add("c-f-active");
      }
    });
  });

  {%- if filterBlocks != empty -%}
    document.querySelectorAll("#{{ section.id }} .c-f-filters .c-f-filter").forEach(filter => {
      filter.addEventListener("click", () => {
        document.querySelectorAll("#{{ section.id }} .c-f-filters .c-f-filter").forEach(filter2 => {
          filter2.classList.remove("c-category-active");
        });
        filter.classList.add("c-category-active");
        if (filter.hasAttribute("data-filter") === true) {
          let myAttribute = "data-filter-" + filter.getAttribute("data-filter");
          document.querySelectorAll("#{{ section.id }} .c-f-grid .c-f-card").forEach(item => {
            item.style.display = "none";
            if (item.hasAttribute(myAttribute)) {
              item.style.display = "inline-block";
            }
          });
        } else {
          document.querySelectorAll("#{{ section.id }} .c-f-grid .c-f-card").forEach(item => {
            item.style.display = "inline-block";
          });
        }
      });
    });
  {%- endif -%}
</script>



{% schema %}
  {
    "name": "C FAQs",
    "blocks": [
      {
        "name": "Item",
        "type": "Item",
        "limit": 50,
        "settings": [
          {
            "type": "text",
            "id": "faq_heading",
            "label": "Question",
            "default": "Question text goes here"
          },
          {
            "type": "richtext",
            "id": "faq_answer",
            "label": "Answer",
            "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique.</p>"
          },
          {
            "type": "text",
            "id": "faq_category",
            "label": "Filter name",
            "default": "Shipping & Returns"
          }
        ]
      },
      {
        "name": "Filter",
        "type": "Filter",
        "limit": 50,
        "settings": [
          {
            "type": "text",
            "id": "filter_text",
            "label": "Filter name",
            "default": "Shipping & Returns"
          }
        ]
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "use_grid",
        "label": "Use grid",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "side",
        "label": "Flip",
        "default": true
      },
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Frequently Asked Questions</p>"
      },
      {
        "type": "richtext",
        "id": "paragraph",
        "label": "Paragraph",
        "default": "<p>Have you got questions? We've got answers!</p>"
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "button_url",
        "label": "Button Link"
      },
      {
        "type": "text",
        "id": "button_style",
        "label": "Button style",
        "default": "c-b1"
      },
      {
        "type": "header",
        "content": "Section Colors"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent color",
        "default": "#C13325"
      },
      {
        "type": "color",
        "id": "card_bg",
        "label": "Card background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "faq_text_border",
        "label": "Faq Card Text Color",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#000"
      },
      {
        "type": "header",
        "content": "Section Top"
      },
      {
        "type": "text",
        "id": "section_top_subheading",
        "label": "Subheading",
        "default": "subheading"
      },
      {
        "type": "text",
        "id": "section_top_heading",
        "label": "Heading",
        "default": "My heading"
      },
      {
        "type": "richtext",
        "id": "section_top_paragraph",
        "label": "Paragraph"
      },
      {
        "type": "select",
        "id": "section_top_alignment",
        "label": "Section Top Alignment",
        "default": "center",
        "options": [
          {
            "value": "flex-start",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "flex-end",
            "label": "Right"
          }
        ]
      },
      {
        "type": "select",
        "id": "text_alignment",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Section Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top",
        "min": 0,
        "max": 15,
        "step": 1,
        "default": 4,
        "unit": "rem"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 15,
        "step": 1,
        "default": 4,
        "unit": "rem"
      }
    ],
    "presets": [
      {
        "name": "C FAQs",
        "blocks": [
          {
            "type": "Item"
          },
          {
            "type": "Item"
          },
          {
            "type": "Item"
          }
        ]
      }
    ]
  }
{% endschema %}