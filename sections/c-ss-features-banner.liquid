{% style %}
  #{{ section.id }}.c-ss-features-banner {
    padding: 30px 20px;
  }

  #{{ section.id }} .c-features-wrap {
    background: #B5D5C5;
    border-radius: 25px;
    max-width: 1384px;
    margin: 0 auto;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    position: relative;
    overflow: hidden;
  }

  #{{ section.id }} .c-features-image {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid #FFFFFF;
    position: relative;
    z-index: 2;
    margin: auto 0;
    max-width: 400px;
  }

  #{{ section.id }} .c-features-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  #{{ section.id }} .c-features-image svg {
    width: 100%;
    height: auto;
    display: block;
    background-color: #AFAFAF;
  }

  #{{ section.id }} .c-features-image-badge {
    position: absolute;
    top: 0;
    left: 0;
    max-width: 220px;
    background-color: transparent !important;
    height: auto !important;
  }

  #{{ section.id }} .c-features-body {
    display: flex;
    flex-direction: column;
    padding: 0;
    position: relative;
    justify-content: end;
    z-index: 2;
  }

  #{{ section.id }} .c-features-heading {
    color: #111111;
    font-family: 'Inter', sans-serif;
    font-size: 36px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    margin: 0 0 30px 0;
  }

  #{{ section.id }} .c-features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  #{{ section.id }} .c-features-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  #{{ section.id }} .c-features-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section.id }} .c-features-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #{{ section.id }} .c-features-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  #{{ section.id }} .c-features-title {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.29;
    color: #111111;
    margin: 0;
  }

  #{{ section.id }} .c-features-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: rgba(17, 17, 17, 0.78);
    letter-spacing: 0.6px;
    margin: 0;
  }

  #{{ section.id }} .c-features-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    background: #F1F1F1;
    color: #111111;
    border-radius: 16px;
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    letter-spacing: 0.6px;
    transition: opacity 0.2s;
    width: 100%;
    max-width: 285px;
    margin: 37px auto 0;
  }

  #{{ section.id }} .c-features-button:hover {
    background: #FAFAFA;
    opacity: 1;
    text-decoration: none;
  }

  #{{ section.id }} .c-features-button:focus,
  #{{ section.id }} .c-features-button:focus-visible,
  #{{ section.id }} .c-features-button:active {
    text-decoration: none;
  }

  #{{ section.id }} .c-features-bottom-flowers {
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 420px;
    height: auto;
    z-index: 1;
    pointer-events: none;
  }

  #{{ section.id }} .c-features-right-flower {
    position: absolute;
    right: 8px;
    bottom: 14px;
    width: 170px;
    height: auto;
    z-index: 1;
    pointer-events: none;
  }

  #{{ section.id }} .c-features-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.25;
  }

  #{{ section.id }} .c-features-bg-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .c-features-item {
      flex-direction: row;
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-ss-features-banner {
      padding: 56px 20px;
    }
    
    #{{ section.id }} .c-features-wrap {
      flex-direction: row;
      gap: 40px;
      padding: 44px 48px;
      min-height: 593px;
    }

    #{{ section.id }} .c-features-heading {
      font-size: 44px;
    }

    #{{ section.id }} .c-features-button {
      margin: 37px 0 0;
    }

    #{{ section.id }} .c-features-image {
      max-width: 440px;
    }

    #{{ section.id }} .c-features-image img,
    #{{ section.id }} .c-features-image svg {
      height: 100%;
      object-fit: cover;
    }

    #{{ section.id }} .c-features-body {
      padding: 0;
    }

    #{{ section.id }} .c-features-grid {
      padding: 30px 0 0;
      border-top: 1px solid rgba(17, 17, 17, 0.16);
    }

    #{{ section.id }} .c-features-bottom-flowers {
      width: 560px;
      bottom: 0px;
      z-index: 3;
    }

    #{{ section.id }} .c-features-right-flower {
      width: 220px;
      right: 14px;
      bottom: 10px;
    }
  }

  @media (min-width: 1224px) {
    #{{ section.id }} .c-features-image {
      max-width: 558px;
      height: 506px;
    }

    #{{ section.id }} .c-features-wrap {
      gap: 80px;
    }

    #{{ section.id }} .c-features-heading {
      margin: 0 0 40px 0;
    }

    #{{ section.id }} .c-features-grid {
      gap: 54px 51px;
      padding: 40px 0;
    }

    #{{ section.id }} .c-features-title {
      font-size: 20px;
    }
  }
{% endstyle %}

