<style>
  #{{ section.id }} {
    font-size: 16px;
    padding-top: {{ section.settings.padding_top }}em;
    padding-bottom: {{ section.settings.padding_bottom }}em;
    background-color: {{ section.settings.bg_color }};
  }

  #{{ section.id }} div,
  #{{ section.id }} h3 {
    color: {{ section.settings.text_color }};
  }

  #{{ section.id }} .c-section-top {
    align-items: {{ section.settings.section_top_alignment }};
    text-align: {{ section.settings.section_top_text_alignment }};
  }

  #{{ section.id }} .c-ct-wrapper {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #{{ section.id }} .c-ct-triggers {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  #{{ section.id }} .c-ct-trigger {
    border: 2px solid {{ section.settings.accent_color }};
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s ease;
  }

  #{{ section.id }} .c-ct-trigger:hover {
    background-color: rgba(193,51,37, 0.25);
  }

  #{{ section.id }} .c-ct-trigger.c-active {
    background-color: {{ section.settings.accent_color }};
    color: #fff;
  }

  #{{ section.id }} .c-ct-item {
    grid-template-columns: 1fr 1fr;
    gap: 0rem;
    border-radius: 20px;
    padding: 2rem;
    background-color: {{ section.settings.card_bg_color }};
    display: none;
  }

  #{{ section.id }} .c-ct-item.c-active {
    display: grid;
  }

  #{{ section.id }} .c-ct-item-left {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #{{ section.id }} .c-ct-item-left img {
    border: 2px solid {{ section.settings.accent_color }};
    border-radius: 20px 0px 0px 20px;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section.id }} .c-ct-item-right {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 20px;
    padding: 2rem;
    width: 100%;
    text-align: center;
    border: 2px solid {{ section.settings.accent_color }};
    border-radius: 0px 20px 20px 0px;
    border-left: none;
    background-color: {{ section.settings.bg_color }};
  }

  #{{ section.id }} .c-ct-items .c-ct-item-right div {
    width: 100%;
  }

  #{{ section.id }} .c-ct-items .c-ct-item-right div p {
    border-bottom: 1px solid #ccc;
    padding: 0 0 20px 0;
    font-size: 20px;
  }

  #{{ section.id }} .c-ct-items .c-ct-item-right div:nth-child(3) p {
    border-bottom: none;
    padding-bottom: 0px;
  }

  @media (max-width: {{ settings.c_breakpoint3 }}px) {
    #{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 }}em;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 }}em;
    }

    #{{ section.id }} .c-ct-item {
      grid-template-columns: 1fr;
    }

    #{{ section.id }} .c-ct-item-left img {
      border-radius: 20px 20px 0px 0px;
    }

    #{{ section.id }} .c-ct-item-right {
      border-radius: 0px 0px 20px 20px;
      border-top: none;
      gap: 10px;
      border-left: 2px solid {{ section.settings.accent_color }};
    }

    #{{ section.id }} .c-ct-items .c-ct-item-right div p {
      font-size: 16px;
      padding: 0 0 10px 0;
    }
  }
</style>


<section id="{{ section.id }}" class="c-section">
  <div class="page-width">
    <div class="c-section-top">
      {%- if section.settings.section_top_subheading != empty -%}<p class="c-section-top-subheading">{{ section.settings.section_top_subheading }}</p>{%- endif -%}
      {%- if section.settings.section_top_heading != empty -%}<h2>{{ section.settings.section_top_heading }}</h2>{%- endif -%}
      {%- if section.settings.section_top_paragraph != empty -%}<div class="c-t-80">{{ section.settings.section_top_paragraph }}</div>{%- endif -%}
    </div>
    <div class="c-ct-wrapper">
      <div class="c-ct-triggers">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'Item' %}
              <div class="c-ct-trigger {% if forloop.first %}c-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.block_heading }}</div>
          {% endcase %}
        {% endfor %}
      </div>
      <div class="c-ct-items">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'Item' %}
              <div class="c-ct-item {% if forloop.first %}c-active{% endif %}" {{ block.shopify_attributes }}>
                <div class="c-ct-item-left">
                  {% if block.settings.block_image %}
                  {{ block.settings.block_image | image_url: width: 1500 | image_tag: loading: 'lazy', height: 'auto' }}
                {% endif %}
                </div>
                <div class="c-ct-item-right">
                  {%- if block.settings.block_paragraph1 != empty -%}<div>{{ block.settings.block_paragraph1 }}</div>{%- endif -%}
                  {%- if block.settings.block_paragraph2 != empty -%}<div>{{ block.settings.block_paragraph2 }}</div>{%- endif -%}
                  {%- if block.settings.block_paragraph3 != empty -%}<div>{{ block.settings.block_paragraph3 }}</div>{%- endif -%}
                  {%- if block.settings.block_paragraph4 != empty -%}<div>{{ block.settings.block_paragraph4 }}</div>{%- endif -%}
                  {%- if block.settings.button_text != empty -%}
                    <a href="{{ block.settings.button_url }}" class="c-button {{ block.settings.button_style }}" >{{ block.settings.button_text }}</a>
                  {%- endif -%}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>


<script>
  document.querySelectorAll("#{{ section.id }} .c-ct-trigger").forEach((tab, index) => {
    tab.addEventListener("click", () => {
      document.querySelectorAll("#{{ section.id }} .c-ct-item").forEach((content) => {
        content.classList.remove("c-active");
      });
      document.querySelectorAll("#{{ section.id }} .c-ct-trigger").forEach((tab) => {
        tab.classList.remove("c-active");
      });
      
      document.querySelectorAll("#{{ section.id }} .c-ct-item")[index].classList.add("c-active");
      document.querySelectorAll("#{{ section.id }} .c-ct-trigger")[index].classList.add("c-active");
    });
  });
</script>


{% schema %}
  {
    "name": "C Compare Tabs",
    "blocks": [
