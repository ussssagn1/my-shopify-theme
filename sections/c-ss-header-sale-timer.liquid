        <div class="c-ss-sale-image-wrap">
          <div class="c-ss-sale-image">
            {%- if section.settings.image -%}
              {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '650, 900, 1200, 1500' }}
            {%- else -%}
              <img
                src="https://www.figma.com/api/mcp/asset/3c0e13d8-b6bc-4716-a3d5-663f39564b3a"
                alt=""
                loading="lazy"
              >
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var root = document.getElementById('shopify-section-' + sectionId);
    if (!root) return;

    function initTimer() {
      var timer = root.querySelector('.c-ss-sale-timer[data-end-date]');
      if (!timer) return;

      if (timer.dataset.intervalId) {
        clearInterval(Number(timer.dataset.intervalId));
      }

      var daysEl = timer.querySelector('[data-days]');
      var hoursEl = timer.querySelector('[data-hours]');
      var minutesEl = timer.querySelector('[data-minutes]');
      var secondsEl = timer.querySelector('[data-seconds]');
      var endDate = timer.getAttribute('data-end-date');
      if (!endDate || !daysEl || !hoursEl || !minutesEl || !secondsEl) return;

      function pad(num) {
        return String(num).padStart(2, '0');
      }

      function setZeros() {
        daysEl.textContent = '00';
        hoursEl.textContent = '00';
        minutesEl.textContent = '00';
        secondsEl.textContent = '00';
      }

      function tick() {
        var now = new Date().getTime();
        var end = new Date(endDate).getTime();
        if (Number.isNaN(end)) {
          setZeros();
          return;
        }

        var distance = end - now;
        if (distance <= 0) {
          setZeros();
          return;
        }

        var days = Math.floor(distance / (1000 * 60 * 60 * 24));
        var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((distance % (1000 * 60)) / 1000);

        daysEl.textContent = pad(days);
        hoursEl.textContent = pad(hours);
        minutesEl.textContent = pad(minutes);
        secondsEl.textContent = pad(seconds);
      }

      tick();
      timer.dataset.intervalId = String(setInterval(tick, 1000));
    }

    function init() {
      root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;
      initTimer();
    }

    init();

    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail && event.detail.sectionId === sectionId) init();
      });

      document.addEventListener('shopify:section:unload', function (event) {
        if (!(event.detail && event.detail.sectionId === sectionId)) return;
        var timer = root && root.querySelector('.c-ss-sale-timer');
        if (timer && timer.dataset.intervalId) clearInterval(Number(timer.dataset.intervalId));
      });
    }
  })();
</script>

{% schema %}
{
  "name": "C SS Header Sale Timer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "15,000+ 5 Star Reviews"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Spring Sale: Up\nto 20% OFF"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description text",
      "default": "Warmer weather is here, gear up with the world's most packable, puffy coolers made for trails, lakes, and every adventure in between."
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show timer",
      "default": true
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Timer label",
      "default": "Limited-Time Spring Sale Ends Soon:"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Sale end date",
      "default": "2026-12-31T23:59:59",
      "info": "Format: YYYY-MM-DDTHH:MM:SS"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Get up to 20% OFF"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "bottom_left_flowers_image",
      "label": "Bottom left flowers image"
    }
  ],
  "presets": [
    {
      "name": "C SS Header Sale Timer"
    }
  ]
}
{% endschema %}
