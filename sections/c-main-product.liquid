<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
  style="background-color: #192A3F;"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  <style>
    #MainProduct-{{ section.id }} .price .price__container .price__sale .price-item.price-item--sale {
      color: var(--primary1);
      font-weight: 700;
    }

    #MainProduct-{{ section.id }} .product__description,
    #MainProduct-{{ section.id }} .c-richtext {
      color: #000;
    }

    #MainProduct-{{ section.id }} .product__text.inline-richtext {
      margin: 0;
    }

    #MainProduct-{{ section.id }} .product__title {
      margin-bottom: 0.5rem;
    }
  </style>

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'c-product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text c-product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'title' -%}
                <div class="product__title c-product__title" {{ block.shopify_attributes }}>
                  <h1>{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>
                </div>
              {%- when 'price' -%}
                <div id="price-{{ section.id }}" class="c-price" role="status" {{ block.shopify_attributes }}>
                  {%- render 'c-new-price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    price_class: 'price--large'
                  -%}
                </div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                    <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {%- endif -%}
              {%- when 'shop_pay_widget' -%}
                {%- render 'c-shop-pay-widget', product: product, section_id: section.id -%}
              {%- when 'cart_free_gift' -%}
                {%- unless block.settings.show_in_buttons -%}
                  {%- render 'c-cart-free-gift', block: block -%}
                {%- endunless -%}
              {%- when 'c_complete_setup' -%}
                {%- render 'c-complete-setup', block: block -%}
              {%- when 'inventory' -%}
                <p
                  class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  id="Inventory-{{ section.id }}"
                  role="status"
                >
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity
                          <= block.settings.inventory_threshold
                      -%}
                        <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_low_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_low_stock' | t -}}
                        {%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_in_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description c-product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'RichText' -%}
                {%- if block.settings.block_paragraph != empty -%}
                  <div class="c-richtext" {{ block.shopify_attributes }}>{{ block.settings.block_paragraph }}</div>
                {%- endif -%}
              {%- when 'sku' -%}
                <p
                  class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                  id="Sku-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                  {{- product.selected_or_first_available_variant.sku -}}
                </p>
              {%- when 'info_banner' -%}
                <div class="c-info-banner" {{ block.shopify_attributes }}>
                  <span class="c-info-banner__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" viewBox="0 0 16 20" fill="none">
                      <path d="M6.79331 12.5L0.868311 11.75C0.451645 11.7 0.180645 11.475 0.0553114 11.075C-0.0700219 10.675 0.0176448 10.3333 0.318311 10.05L10.5433 0.25C10.6266 0.166667 10.7266 0.104333 10.8433 0.063C10.96 0.0216666 11.1183 0.000666667 11.3183 0C11.6516 0 11.906 0.141667 12.0813 0.425C12.2566 0.708333 12.2606 1 12.0933 1.3L8.79331 7.5L14.7183 8.25C15.135 8.3 15.406 8.525 15.5313 8.925C15.6566 9.325 15.569 9.66667 15.2683 9.95L5.04331 19.75C4.95998 19.8333 4.85998 19.896 4.74331 19.938C4.62664 19.98 4.46831 20.0007 4.26831 20C3.93498 20 3.68064 19.8583 3.50531 19.575C3.32998 19.2917 3.32598 19 3.49331 18.7L6.79331 12.5Z" fill="white"/>
                    </svg>
                  </span>
                  <span class="c-info-banner__text">{{ block.settings.text }}</span>
                </div>
                  {%- when 'video_item' -%}
                {%- liquid
                  assign is_first_video = false
                  assign found_video = false
                  
                  for b in section.blocks
                    if b.type == 'video_item' and found_video == false
                      if b.id == block.id
                        assign is_first_video = true
                      endif
                      assign found_video = true
                    endif
                  endfor
                -%}
                
                {%- if is_first_video -%}
                  <div class="product-block c-video-slider-block" id="c-video-slider-{{ section.id }}">
                    {% style %}
                      #c-video-slider-{{ section.id }}.c-video-slider-block {
                        padding: 0;
                        margin: 30px 0;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-wrapper {
                        width: 100%;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-header {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        margin-bottom: 15px;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-heading {
                        color: #FFF;
                        font-family: Inter;
                        font-size: 14px;
                        font-style: normal;
                        font-weight: 700;
                        line-height: 1.29;
                        text-transform: uppercase;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-navigation {
                        display: flex;
                        gap: 4px;
                        align-items: center;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-nav-btn {
                        width: 20px;
                        height: 20px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        background: transparent;
                        cursor: pointer;
                        padding: 0;
                        transition: all 0.3s ease;
                        border: 0px !important;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-nav-btn.swiper-button-disabled {
                        opacity: 0.3;
                        cursor: not-allowed;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-container {
                        overflow: hidden;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-slide {
                        height: 150px;
                        position: relative;
                        overflow: hidden;
                        border-radius: 4px;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-placeholder {
                        width: 100%;
                        height: 100%;
                        background: rgba(255, 255, 255, 0.08);
                        border-radius: 4px;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        gap: 8px;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-placeholder svg {
                        opacity: 0.4;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-slide-inner {
                        position: relative;
                        width: 100%;
                        height: 100%;
                        cursor: pointer;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-thumbnail {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        display: block;
                        border-radius: 4px;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-overlay {
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        background: rgba(0, 0, 0, 0.2);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        transition: background 0.3s ease;
                        border-radius: 4px;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-slide-inner:hover .c-video-slider-overlay {
                        background: rgba(0, 0, 0, 0.3);
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-play-icon {
                        width: 22px;
                        height: 22px;
                        position: relative;
                        z-index: 1;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-play-icon svg {
                        width: 100%;
                        height: 100%;
                        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal {
                        display: none;
                        position: fixed;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        background: rgba(0, 0, 0, 0.9);
                        z-index: 9999;
                        align-items: center;
                        justify-content: center;
                        padding: 20px;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal.active {
                        display: flex;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-content {
                        position: relative;
                        width: 100%;
                        max-width: 900px;
                        aspect-ratio: 16/9;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-close {
                        position: absolute;
                        top: -40px;
                        right: 0;
                        background: transparent;
                        border: none;
                        color: white;
                        font-size: 30px;
                        cursor: pointer;
                        padding: 0;
                        width: 40px;
                        height: 40px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        z-index: 10;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-video {
                        width: 100%;
                        height: 100%;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-controls {
                        position: absolute;
                        top: 20px;
                        left: 20px;
                        right: 20px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        z-index: 10;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-back {
                        background: transparent;
                        border: none;
                        color: white;
                        cursor: pointer;
                        padding: 0;
                        width: 40px;
                        height: 40px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-back:hover {
                        opacity: 0.7;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-back svg {
                        width: 24px;
                        height: 24px;
                      }

                      #c-video-slider-{{ section.id }} .c-video-slider-modal-close {
                        position: static;
                        background: transparent;
                        border: none;
                        color: white;
                        font-size: 30px;
                        cursor: pointer;
                        padding: 0;
                        width: 40px;
                        height: 40px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                      }

                      @media screen and (min-width: 1024px) {
                        #c-video-slider-{{ section.id }} .c-video-slider-slide {
                          height: 180px;
                        }

                        #c-video-slider-{{ section.id }}.c-video-slider-block {
                          margin: 40px 0;
                        }

                        #c-video-slider-{{ section.id }} .c-video-slider-header {
                          margin-bottom: 20px;
                        }

                        #c-video-slider-{{ section.id }} .c-video-slider-nav-btn svg {
                          width: 20px;
                          height: 20px;
                        }
                      }
                    {% endstyle %}

                    <div class="c-video-slider-wrapper">
                      <div class="c-video-slider-header">
                        <h3 class="c-video-slider-heading">{{ section.settings.slider_heading }}</h3>
                        <div class="c-video-slider-navigation">
                          <button class="c-video-slider-nav-btn c-video-slider-prev-{{ section.id }}" aria-label="Previous">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                              <rect x="19.6296" y="0.37037" width="19.2593" height="19.2593" rx="9.62963" transform="rotate(90 19.6296 0.37037)" stroke="#ffffff" stroke-width="0.740741"/>
                              <path d="M11.6094 5.49219L7.26155 9.84001L11.6094 14.1878" stroke="#ffffff" stroke-width="0.740741" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                          <button class="c-video-slider-nav-btn c-video-slider-next-{{ section.id }}" aria-label="Next">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                              <rect x="0.37037" y="19.6296" width="19.2593" height="19.2593" rx="9.62963" transform="rotate(-90 0.37037 19.6296)" stroke="#ffffff" stroke-width="0.740741"/>
                              <path d="M8.39062 14.1875L12.7385 9.83967L8.39063 5.49185" stroke="#ffffff" stroke-width="0.740741" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        </div>
                      </div>

                      <div class="c-video-slider-container swiper" data-video-slider="{{ section.id }}">
                        <div class="swiper-wrapper">
                          {% for block in section.blocks %}
                            {% if block.type == 'video_item' %}
                              <div class="swiper-slide c-video-slider-slide" {{ block.shopify_attributes }}>
                                {% if block.settings.video or block.settings.thumbnail %}
                                  <div class="c-video-slider-slide-inner" data-video-url="{{ block.settings.video.sources[0].url }}">
                                    {% if block.settings.thumbnail != blank %}
                                      {{ block.settings.thumbnail | image_url: width: 600 | image_tag: class: 'c-video-slider-thumbnail', loading: 'lazy' }}
                                    {% elsif block.settings.video.preview_image %}
                                      {{ block.settings.video.preview_image | image_url: width: 600 | image_tag: class: 'c-video-slider-thumbnail', loading: 'lazy' }}
                                    {% else %}
                                      <div class="c-video-slider-thumbnail" style="background: #2a2a2a;"></div>
                                    {% endif %}
                                    <div class="c-video-slider-overlay">
                                      <div class="c-video-slider-play-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                          <foreignObject x="-16.0621" y="-16.0621" width="56.1243" height="56.1243"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(8.03px);clip-path:url(#bgblur_0_3410_1122_clip_path);height:100%;width:100%"></div></foreignObject><path data-figma-bg-blur-radius="16.0621" d="M12 24C18.6274 24 24 18.6274 24 12C24 5.37258 18.6274 0 12 0C5.37258 0 0 5.37258 0 12C0 18.6274 5.37258 24 12 24Z" fill="#3E1910" fill-opacity="0.12"/>
                                          <path d="M8.94141 7.5293L16.6053 11.9999L8.94141 16.4705V7.5293Z" fill="#FDFCFA"/>
                                          <defs><clipPath id="bgblur_0_3410_1122_clip_path" transform="translate(16.0621 16.0621)"><path d="M12 24C18.6274 24 24 18.6274 24 12C24 5.37258 18.6274 0 12 0C5.37258 0 0 5.37258 0 12C0 18.6274 5.37258 24 12 24Z"/></clipPath></defs>
                                        </svg>
                                      </div>
                                    </div>
                                  </div>
                                {% else %}
                                  <div class="c-video-slider-placeholder">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none">
                                      <path d="M15 10l4.553-2.277A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14M3 8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8z" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </div>
                                {% endif %}
                              </div>
                            {% endif %}
                          {% endfor %}
                        </div>
                      </div>

                      <div class="c-video-slider-modal" id="video-modal-{{ section.id }}">
                        <div class="c-video-slider-modal-controls">
                          <button class="c-video-slider-modal-back" aria-label="Back">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M15 18L9 12L15 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                          <button class="c-video-slider-modal-close" aria-label="Close">&times;</button>
                        </div>
                        <div class="c-video-slider-modal-content">
                          <div class="c-video-slider-modal-video" id="video-player-{{ section.id }}"></div>
                        </div>
                      </div>
                    </div>

                    <script>
                      (function() {
                        const sectionId = '{{ section.id }}';
                        const swiperEl = document.querySelector('[data-video-slider="' + sectionId + '"]');
                        
                        if (swiperEl && typeof Swiper !== 'undefined') {
                          const swiper = new Swiper(swiperEl, {
                            slidesPerView: 2.5,
                            spaceBetween: 8,
                            navigation: {
                              nextEl: '.c-video-slider-next-' + sectionId,
                              prevEl: '.c-video-slider-prev-' + sectionId,
                            },
                            breakpoints: {
                              576: {
                                slidesPerView: 2.5,
                                spaceBetween: 8
                              },
                              1024: {
                                slidesPerView: 4,
                                spaceBetween: 12
                              }
                            }
                          });

                          const modal = document.getElementById('video-modal-' + sectionId);
                          const modalClose = modal.querySelector('.c-video-slider-modal-close');
                          const videoPlayer = document.getElementById('video-player-' + sectionId);
                          const slides = swiperEl.querySelectorAll('.c-video-slider-slide-inner');

                          slides.forEach(function(slide) {
                            slide.addEventListener('click', function() {
                              const videoUrl = this.getAttribute('data-video-url');
                              
                              if (videoUrl) {
                                videoPlayer.innerHTML = '<video width="100%" height="100%" controls autoplay><source src="' + videoUrl + '" type="video/mp4"></video>';
                                modal.classList.add('active');
                                document.body.style.overflow = 'hidden';
                              }
                            });
                          });

                          modalClose.addEventListener('click', function() {
                            modal.classList.remove('active');
                            videoPlayer.innerHTML = '';
                            document.body.style.overflow = '';
                          });

                          modal.addEventListener('click', function(e) {
                            if (e.target === modal) {
                              modal.classList.remove('active');
                              videoPlayer.innerHTML = '';
                              document.body.style.overflow = '';
                            }
                          });

                          const modalBack = modal.querySelector('.c-video-slider-modal-back');

                          modalBack.addEventListener('click', function() {
                            modal.classList.remove('active');
                            videoPlayer.innerHTML = '';
                            document.body.style.overflow = '';
                          });
                        }
                      })();
                    </script>
                  </div>
                {%- endif -%}

