{% style %}
  #{{ section.id }}.c-uc {
    width: 100%;
    padding: 40px 20px;
    box-sizing: border-box;
    background: #F8F8F8;
  }

  #{{ section.id }} .c-uc-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }

  #{{ section.id }} .c-uc-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  #{{ section.id }} .c-uc-caption {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.29;
    color: #C13325;
    text-transform: uppercase;
    margin: 0;
  }

  #{{ section.id }} .c-uc-heading {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
    color: #000;
    margin: 0;
  }

  #{{ section.id }} .c-uc-slider {
    width: 100%;
    overflow: hidden;
  }

  #{{ section.id }} .c-uc-slider .swiper-wrapper {
    align-items: stretch !important;
  }

  #{{ section.id }} .c-uc-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    min-height: 513px;
    display: flex;
    flex-direction: column;
    height: auto !important;
  }

  #{{ section.id }} .c-uc-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section.id }} .c-uc-card-top {
    position: relative;
    z-index: 1;
    flex: 1;
    padding: 24px 20px 20px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0) 55%);
    display: flex;
    flex-direction: column;
  }

  #{{ section.id }} .c-uc-card-title {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: 36px;
    line-height: 1.0;
    color: #fff;
    margin: 0;
  }

  #{{ section.id }} .c-uc-card-underline {
    display: block;
    margin: 6px 0 10px;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-uc-card-subtitle-1,
  #{{ section.id }} .c-uc-card-subtitle-2 {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  #{{ section.id }} .c-uc-card-bg {
    position: absolute;
    bottom: -4%;
    left: 0;
    width: 100%;
    z-index: 1;
    display: block;
    pointer-events: none;
  }

  #{{ section.id }} .c-uc-card-bottom {
    position: relative;
    z-index: 2;
    padding: 14px 30px 20px;
  }

  #{{ section.id }} .c-uc-best-for {
    color: #FFF;
    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 600;
    line-height: 110%;
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  #{{ section.id }} .c-uc-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
  }

  #{{ section.id }} .c-uc-feature:first-child {
    padding-top: 0;
  }

  #{{ section.id }} .c-uc-feature + .c-uc-feature {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  #{{ section.id }} .c-uc-feature svg {
    flex-shrink: 0;
  }

  #{{ section.id }} .c-uc-feature-text {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 14px;
    line-height: 1.3;
    color: #fff;
    margin: 0;
  }

  /* Nav */
  #{{ section.id }} .c-uc-nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #{{ section.id }} .c-uc-nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: #192A3F;
    border-radius: 22px;
    border: none;
    cursor: pointer;
    padding: 10px;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  #{{ section.id }} .c-uc-nav-btn:hover {
    background: #0f1e2e;
  }

  #{{ section.id }} .c-uc-nav-btn svg {
    display: block;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-uc-nav-btn.swiper-button-disabled {
    opacity: 0.45;
    cursor: default;
  }

  @media (min-width: 768px) {
    #{{ section.id }}.c-uc {
      padding: 64px;
    }

    #{{ section.id }} .c-uc-heading {
      font-size: 44px;
    }

    #{{ section.id }} .c-uc-nav {
      display: none;
    }

    #{{ section.id }} .c-uc-card-title {
      font-size: 40px;
    }

    #{{ section.id }} .c-uc-card-bottom {
      padding: 14px 10px 20px;
    }
  }

  @media (min-width: 1024px) {
    #{{ section.id }} .c-uc-card-bottom {
      padding: 14px 30px 20px;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="c-uc">
  <div class="c-uc-inner">

    {% if section.settings.caption != blank or section.settings.heading != blank %}
      <div class="c-uc-header">
        {% if section.settings.caption != blank %}
          <p class="c-uc-caption">{{ section.settings.caption }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="c-uc-heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div id="swiper-{{ section.id }}" class="c-uc-slider swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="c-uc-card swiper-slide" {{ block.shopify_attributes }}>

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  class: 'c-uc-card-img',
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            {% endif %}

