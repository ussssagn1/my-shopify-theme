{% style %}
  #{{ section.id }}.c-footer {
    background-color: #192A3F;
    font-family: 'Inter', sans-serif;
    width: 100%;
    box-sizing: border-box;
  }

  #{{ section.id }} *,
  #{{ section.id }} *::before,
  #{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #{{ section.id }} .c-footer__newsletter {
    background-color: #C13325;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section.id }} .c-footer__newsletter-inner {
    width: 100%;
    max-width: 1440px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0 auto;
  }

  #{{ section.id }} .c-footer__newsletter-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.1;
    color: #fff;
    margin: 0;
    min-width: 0;
    text-align: center;
    text-transform: uppercase;
  }

  #{{ section.id }} .c-footer__newsletter-form {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-footer__newsletter-input {
    flex: 1;
    width: auto;
    min-width: 0;
    height: 48px;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    padding: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #222;
    outline: none;
  }

  #{{ section.id }} .c-footer__newsletter-input::placeholder {
    color: #A6A6A6;
  }

  #{{ section.id }} .c-footer__newsletter-btn {
    height: 48px;
    min-width: 119px;
    background: #fff;
    border: none;
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #C13325;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }

  #{{ section.id }} .c-footer__newsletter-btn:hover {
    opacity: 0.88;
  }

  #{{ section.id }} .c-footer__blue {
    position: relative;
    overflow: hidden;
  }

  #{{ section.id }} .c-footer__blue::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom right, transparent 55%, rgba(255,255,255,0.06) 55%);
    pointer-events: none;
    z-index: 0;
  }

  #{{ section.id }} .c-footer__main {
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
  }

  #{{ section.id }} .c-footer__brand {
    width: 100%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 40px;
    padding-bottom: 56px;
  }

  #{{ section.id }} .c-footer__logo-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #{{ section.id }} .c-footer__logo {
    display: inline-block;
    text-decoration: none;
    width: max-content;
    max-width: 141px;
  }

  #{{ section.id }} .c-footer__logo img {
    width: 100%;
    height: 100%;
    display: block;
  }

  #{{ section.id }} .c-footer__logo-text {
    font-size: 28px;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.05em;
    display: inline-block;
  }

  #{{ section.id }} .c-footer__desc {
    font-size: 14px;
    font-weight: 400;
    line-height: 22px;
    color: #F6F6EC;
    margin: 0;
  }

  #{{ section.id }} .c-footer__socials {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #{{ section.id }} .c-footer__socials-label {
    font-size: 16px;
    font-weight: 400;
    color: #fff;
    margin: 0;
    line-height: normal;
  }

  #{{ section.id }} .c-footer__social-icons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #{{ section.id }} .c-footer__social-link {
    width: 40px;
    height: 40px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s;
    overflow: hidden;
  }

  #{{ section.id }} .c-footer__social-link:hover {
    opacity: 0.8;
  }

  #{{ section.id }} .c-footer__social-link:not(.instagram) svg {
    display: block;
    fill: #192A3F;
  }

  #{{ section.id }} .c-footer__menus {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    min-width: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 25px;
  }

  #{{ section.id }} .c-footer__menu-col {
    flex: none;
    width: 50%;
    padding: 0 0 36px 0;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  #{{ section.id }} .c-footer__menu-col:first-child {
    padding-left: 0;
  }

  #{{ section.id }} .c-footer__menu-col:nth-child(odd) {
    padding-right: 20px;
  }

  #{{ section.id }} .c-footer__menu-col--full {
    width: 100%;
    padding-right: 0;
  }

  #{{ section.id }} .c-footer__menu-heading {
    font-size: 18px;
    font-weight: 700;
    line-height: normal;
    color: #fff;
    margin: 0 0 5px;
    padding-bottom: 5px;
    display: inline-block;
    white-space: nowrap;
    align-self: flex-start;
    position: relative;
  }

  .c-footer__menu-heading:after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    height: 2px;
    background-color: #C13325;
    width: 48px;
  }

  #{{ section.id }} .c-footer__menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #{{ section.id }} .c-footer__menu-list a {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: #EEEEEE;
    text-decoration: none;
    display: inline-block;
    transition: color 0.15s;
  }

  #{{ section.id }} .c-footer__menu-list a:hover {
    color: #fff;
    text-decoration: underline;
  }

  #{{ section.id }} .c-footer__bottom {
    position: relative;
    z-index: 1;
    margin: 0 auto;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 21px;
    padding: 21px 0px 28px;
  }

  #{{ section.id }} .c-footer__bottom-wrapper {
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
    padding: 0 21px;
  }

  #{{ section.id }} .c-footer__copyright {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: #EEEEEE;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-footer__copyright-dot {
    opacity: 0.5;
  }

  #{{ section.id }} .c-footer__payments {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  #{{ section.id }} .c-footer__payments svg {
    height: 24px;
    width: auto;
    display: block;
  }

  @media screen and (min-width: 1024px) {
    #{{ section.id }} .c-footer__newsletter {
      height: 130px;
    }

    #{{ section.id }} .c-footer__newsletter-inner {
      padding: 0 78px;
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }

    #{{ section.id }} .c-footer__newsletter-title {
      font-size: 22px;
      flex-shrink: 1;
      text-align: left;
      text-transform: unset;
    }

    #{{ section.id }} .c-footer__newsletter-form {
      width: auto;
    }

    #{{ section.id }} .c-footer__newsletter-input {
      flex: 0 1 398px;
      width: 398px;
      min-width: 180px;
    }

    #{{ section.id }} .c-footer__blue::after {
      width: 661px;
      background: linear-gradient(to bottom right, transparent 50%, rgba(255,255,255,0.06) 50%);
    }

    #{{ section.id }} .c-footer__main {
      padding: 0 75px;
      flex-direction: row;
      align-items: stretch;
    }

    #{{ section.id }} .c-footer__logo {
      max-width: 203px;
    }

    #{{ section.id }} .c-footer__brand {
      max-width: 305px;
      padding-top: 30px;
      padding-bottom: 50px;
      padding-right: 25px;
    }

    #{{ section.id }} .c-footer__menus {
      flex: 1;
      flex-wrap: nowrap;
      align-items: stretch;
      border-top: none;
      padding-top: 0;
    }

    #{{ section.id }} .c-footer__menu-col {
      flex: 1;
      min-width: 0;
      width: auto;
      padding: 30px 30px 30px;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }

    #{{ section.id }} .c-footer__menu-col:first-child {
      padding-left: 30px;
    }

    #{{ section.id }} .c-footer__menu-col:nth-child(odd) {
      padding-right: 30px;
    }

    #{{ section.id }} .c-footer__menu-col--full {
      width: auto;
      padding-right: 30px;
    }

    #{{ section.id }} .c-footer__bottom {
      padding: 20px 0px 32px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

     #{{ section.id }} .c-footer__bottom-wrapper {
      padding: 0 75px;
    }

    #{{ section.id }} .c-footer__payments {
      justify-content: flex-end;
    }
  }

  @media screen and (min-width: 1224px) {
    #{{ section.id }} .c-footer__brand {
      max-width: 395px;
    }
  }
{% endstyle %}

{%- assign newsletter_block = section.blocks | where: 'type', 'newsletter' | first -%}
{%- assign logo_block = section.blocks | where: 'type', 'logo' | first -%}
{%- assign text_block = section.blocks | where: 'type', 'text' | first -%}
{%- assign socials_block = section.blocks | where: 'type', 'socials' | first -%}
{%- assign bottom_block = section.blocks | where: 'type', 'bottom_text' | first -%}
{%- assign payment_block = section.blocks | where: 'type', 'payment' | first -%}
{%- assign menu_blocks = section.blocks | where: 'type', 'menu_item' -%}
{%- assign menu_count = menu_blocks | size -%}

<footer id="{{ section.id }}" class="c-footer">

  {%- if newsletter_block != blank -%}
    <div class="c-footer__newsletter" {{ newsletter_block.shopify_attributes }}>
      <div class="c-footer__newsletter-inner">
      {%- if newsletter_block.settings.title != blank -%}
        <p class="c-footer__newsletter-title">{{ newsletter_block.settings.title }}</p>
      {%- endif -%}
      {%- form 'customer', id: 'ContactFooter', class: 'c-footer__newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          class="c-footer__newsletter-input"
          placeholder="{{ newsletter_block.settings.placeholder | default: 'Enter your email' }}"
          aria-label="{{ newsletter_block.settings.placeholder | default: 'Enter your email' }}"
          required
          autocorrect="off"
          autocapitalize="off"
        >
        <button type="submit" class="c-footer__newsletter-btn">
          {{ newsletter_block.settings.button_label | default: 'Subscribe' }}
        </button>
      {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="c-footer__blue">

    <div class="c-footer__main">

      <div class="c-footer__brand">
        {%- if logo_block != blank -%}
          <div class="c-footer__logo-wrap" {{ logo_block.shopify_attributes }}>
            {%- if logo_block.settings.logo != blank -%}
              <a href="/" class="c-footer__logo">
                {{ logo_block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy' }}
              </a>
            {%- else -%}
              <a href="/" class="c-footer__logo-text">{{ shop.name }}</a>
            {%- endif -%}
            {%- if text_block != blank -%}
              <p class="c-footer__desc" {{ text_block.shopify_attributes }}>{{ text_block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if socials_block != blank -%}
          <div class="c-footer__socials" {{ socials_block.shopify_attributes }}>
            <p class="c-footer__socials-label">Find us on</p>
            <div class="c-footer__social-icons">
              {%- if socials_block.settings.facebook_url != blank -%}
                <a class="c-footer__social-link" href="{{ socials_block.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M10.3936 18V9.78996H13.1482L13.5615 6.58941H10.3936V4.54632C10.3936 3.61998 10.6498 2.98869 11.9796 2.98869L13.673 2.98799V0.125307C13.3802 0.0872508 12.3749 0 11.2049 0C8.76181 0 7.08919 1.49127 7.08919 4.22934V6.58941H4.32617V9.78996H7.08919V18H10.3936Z" fill="black"/>
                  </svg>
                </a>
              {%- endif -%}
              {%- if socials_block.settings.instagram_url != blank -%}
                <a class="c-footer__social-link instagram" href="{{ socials_block.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <g clip-path="url(#clip0_4031_361)">
                        <mask id="mask0_4031_361" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="22" height="22">
                        <path d="M0 3.8147e-06H22V22H0V3.8147e-06Z" fill="white"/>
                        </mask>
                        <g mask="url(#mask0_4031_361)">
                        <path d="M21.1417 11.001C21.1396 11.9054 21.1293 12.8097 21.117 13.714C21.102 14.805 21.0852 15.8965 20.8115 16.9688C20.5246 18.0933 19.9587 19.0631 19.0783 19.7811C18.1505 20.5377 17.0291 20.9354 15.8188 21.009C14.2135 21.1066 12.6075 21.1452 11.0015 21.1414C9.39552 21.1452 7.78952 21.1066 6.18425 21.009C4.97391 20.9354 3.85251 20.5377 2.92473 19.7811C2.0443 19.0631 1.4784 18.0933 1.19146 16.9688C0.917833 15.8965 0.900989 14.805 0.886079 13.714C0.873704 12.8097 0.863434 11.9054 0.861328 11.001C0.863434 10.0967 0.873704 9.19236 0.886079 8.28809C0.900989 7.19707 0.917833 6.10557 1.19146 5.03325C1.4784 3.90875 2.0443 2.93895 2.92473 2.22098C3.85251 1.46439 4.97391 1.06671 6.18425 0.993109C7.78952 0.895484 9.39552 0.856898 11.0015 0.86068C12.6075 0.856898 14.2135 0.895484 15.8188 0.993109C17.0291 1.06671 18.1505 1.46439 19.0783 2.22098C19.9587 2.93895 20.5246 3.90875 20.8115 5.03325C21.0852 6.10557 21.102 7.19707 21.117 8.28809C21.1293 9.19236 21.1396 10.0967 21.1417 11.001Z" stroke="black" stroke-width="1.84895" stroke-miterlimit="10"/>
                        <path d="M15.4688 11.001C15.4688 13.4928 13.4488 15.5128 10.957 15.5128C8.46527 15.5128 6.44531 13.4928 6.44531 11.001C6.44531 8.50928 8.46527 6.48932 10.957 6.48932C13.4488 6.48932 15.4688 8.50928 15.4688 11.001Z" stroke="black" stroke-width="1.84895" stroke-miterlimit="10"/>
                        <path d="M18.2207 5.20026C18.2207 5.91216 17.6435 6.48932 16.9316 6.48932C16.2197 6.48932 15.6426 5.91216 15.6426 5.20026C15.6426 4.48835 16.2197 3.91119 16.9316 3.91119C17.6435 3.91119 18.2207 4.48835 18.2207 5.20026Z" fill="black"/>
                        </g>
                    </g>
                    <defs>
                        <clipPath id="clip0_4031_361">
                        <rect width="22" height="22" fill="white"/>
                        </clipPath>
                    </defs>
                    </svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if menu_count > 0 -%}
        <div class="c-footer__menus">
          {%- assign mob_col_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'menu_item' -%}
              {%- assign nav = linklists[block.settings.menu] -%}
              {%- assign mob_col_index = mob_col_index | plus: 1 -%}
              {%- assign is_last = false -%}
              {%- if menu_count == mob_col_index -%}{%- assign is_last = true -%}{%- endif -%}
              {%- assign menu_count_odd = menu_count | modulo: 2 -%}
              {%- assign is_odd_last = false -%}
              {%- if is_last and menu_count_odd == 1 -%}{%- assign is_odd_last = true -%}{%- endif -%}
              <div class="c-footer__menu-col{% if is_odd_last %} c-footer__menu-col--full{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <p class="c-footer__menu-heading">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if nav.links.size > 0 -%}
                  <ul class="c-footer__menu-list">
                    {%- for link in nav.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    <div class="c-footer__bottom-wrapper">
      <div class="c-footer__bottom">
        {%- if bottom_block != blank -%}
          <div class="c-footer__copyright" {{ bottom_block.shopify_attributes }}>
            <span>{{ bottom_block.settings.copyright | default: '© 2026, Monti Coolers' }}</span>
          </div>
        {%- endif -%}

        {%- if payment_block != blank and payment_block.settings.show_payment -%}
          <div class="c-footer__payments" {{ payment_block.shopify_attributes }}>
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>

</footer>

{% schema %}
{
  "name": "С Footer",
  "settings": [],
  "blocks": [
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Be first to know about sales, restocks & drops."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Input placeholder",
          "default": "Enter your email"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Subscribe"
        }
      ]
    },
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        }
      ]
    },
    {
      "type": "text",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Description text",
          "default": "Monti Coolers makes durable, leakproof coolers and bags designed for life outdoors. Built to keep things cold wherever the adventure takes you."
        }
      ]
    },
    {
      "type": "socials",
      "name": "Social icons",
      "limit": 1,
      "settings": [
        {
          "type": "url",
          "id": "facebook_url",
          "label": "Facebook URL"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Instagram URL"
        }
      ]
    },
    {
      "type": "menu_item",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "bottom_text",
      "name": "Bottom bar",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "copyright",
          "label": "Copyright text",
          "default": "© 2026, Monti Coolers"
        }
      ]
    },
    {
      "type": "payment",
      "name": "Payment icons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_payment",
          "label": "Show payment icons",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "С Footer",
      "blocks": [
        { "type": "newsletter" },
        { "type": "logo" },
        { "type": "text" },
        { "type": "socials" },
        { "type": "menu_item", "settings": { "heading": "Product" } },
        { "type": "menu_item", "settings": { "heading": "Company" } },
        { "type": "menu_item", "settings": { "heading": "Help" } },
        { "type": "bottom_text" },
        { "type": "payment" }
      ]
    }
  ]
}
{% endschema %}
