{% style %}
  #{{ section.id }}.c-sale-section {
    padding: 0 20px 30px;
  }

  #{{ section.id }} .c-sale-wrap {
    background: #192A3F;
    border-radius: 25px;
    max-width: 1384px;
    margin: 0 auto;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: relative;
    overflow: hidden;
  }

  #{{ section.id }} .c-sale-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.25;
  }

  .c-sale-bg-left-top-icon {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  .c-sale-bg-right-top-icon {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
  }

  .c-sale-bg-bottom-left-icon {
    position: absolute;
    bottom: 80px;
    left: 0;
    z-index: 1;
  }

  #{{ section.id }} .c-sale-bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section.id }} .c-sale-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: 100%;
  }

  #{{ section.id }} .c-sale-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 31px;
  }

  #{{ section.id }} .c-sale-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #{{ section.id }} .c-sale-top {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #{{ section.id }} .c-sale-rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 12px;
    border-radius: 60px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.69);
    width: fit-content;
    margin: 0 auto;
  }

  #{{ section.id }} .c-sale-stars {
    display: flex;
    gap: 4px;
  }

  #{{ section.id }} .c-sale-star {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  #{{ section.id }} .c-sale-rating-text {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: #FFFFFF;
    letter-spacing: 0.6px;
    white-space: nowrap;
  }

  #{{ section.id }} .c-sale-heading {
    font-family: 'Inter', sans-serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.2;
    color: #FFFFFF;
    letter-spacing: -1.86px;
    margin: 0;
  }

  #{{ section.id }} .c-sale-text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    color: #FFFFFF;
    letter-spacing: 0.6px;
    margin: 0 auto;
    max-width: 90%
  }

  #{{ section.id }} .c-sale-timer-wrap {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  #{{ section.id }} .c-sale-timer-label {
    margin: 0;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.55;
    color: #FFFFFF;
    letter-spacing: 0.6px;
  }

  #{{ section.id }} .c-sale-timer {
    display: flex;
    gap: 10px;
  }

  #{{ section.id }} .c-sale-timer-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 55px;
    height: 50px;
    border-radius: 9px;
    background: rgba(193, 51, 37, 0.05);
    border: 1px solid transparent;
    backdrop-filter: blur(5.5px);
    -webkit-backdrop-filter: blur(5.5px);
    padding: 4px 8px;
    gap: 2px;
    position: relative;
  }


  #{{ section.id }} .c-sale-timer-item::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9px;
    padding: 1px;
    background: linear-gradient(130deg, #C13325, #F09E68, #C13325);
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    pointer-events: none;
  }

  #{{ section.id }} .c-sale-timer-value {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    color: #FFFFFF;
    letter-spacing: 0.6px;
  }

  #{{ section.id }} .c-sale-timer-unit {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.55;
    color: #FFFFFF;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  #{{ section.id }} .c-sale-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 50px;
    background: #C13325;
    color: #FFFFFF;
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.29;
    text-decoration: none;
    transition: opacity 0.2s;
    align-self: flex-start;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  #{{ section.id }} .c-sale-button:hover {
    opacity: 0.9;
  }

  #{{ section.id }} .c-sale-image {
    width: 100%;
    position: relative;
  }

  #{{ section.id }} .c-sale-image img,
  #{{ section.id }} .c-sale-image svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  #{{ section.id }} .c-sale-image svg {
    background-color: #AFAFAF;
  }

  @media (min-width: 768px) {
    #{{ section.id }} .c-sale-heading {
      font-size: 48px;
    }

    #{{ section.id }} .c-sale-text {
      font-size: 18px;
    }

    #{{ section.id }} .c-sale-timer {
      gap: 13px;
    }

    #{{ section.id }} .c-sale-timer-item {
      width: 65px;
      height: 57px;
    }

    #{{ section.id }} .c-sale-timer-value {
      font-size: 20px;
    }

    #{{ section.id }} .c-sale-timer-unit {
      font-size: 12px;
    }

    #{{ section.id }} .c-sale-button {
      width: auto;
      padding: 16px 63px;
      font-size: 20px;
    }
  }

  @media (min-width: 1024px) {
    #{{ section.id }}.c-sale-section {
      padding: 0 20px 56px;
    }

    #{{ section.id }} .c-sale-wrap {
      flex-direction: row;
      gap: 60px;
      padding: 60px 0px;
      padding-left: 80px;
      padding-right: 40px;
      align-items: center;
      min-height: 640px;
      padding-bottom: 34px;
    }

    #{{ section.id }} .c-sale-content {
      flex-direction: row;
      gap: 60px;
    }
    
    #{{ section.id }} .c-sale-text {
      margin: 0;
      max-width: none;
    }

    #{{ section.id }} .c-sale-body {
      max-width: 554px;
      align-items: flex-start;
      text-align: left;
    }

    #{{ section.id }} .c-sale-rating {
      margin: 0;
    }

    #{{ section.id }} .c-sale-button {
      margin: 0;
    }

    #{{ section.id }} .c-sale-image {
      max-width: 658px;
    }
  }

  @media (min-width: 1280px) {
    #{{ section.id }} .c-sale-wrap {
      padding: 73px 0px;
      padding-left: 120px;
      padding-right: 53px;
    }

    #{{ section.id }} .c-sale-heading {
      font-size: 62px;
    }
  }
{% endstyle %}

