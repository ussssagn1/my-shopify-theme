{% style %}
  #{{ section.id }}.c-ss-header-sale-timer {
    padding: 0 20px 42px;
  }

  #{{ section.id }}.c-ss-header-sale-timer * {
    box-sizing: border-box;
  }

  #{{ section.id }} .c-ss-shell {
    max-width: 1384px;
    margin: 0 auto;
  }

  #{{ section.id }} .c-ss-sale-wrap {
    background: #F5E6C8;
    border-radius: 25px;
    position: relative;
    overflow: hidden;
    padding: 68px 53px 68px 95px;
    min-height: 640px;
  }

  #{{ section.id }} .c-ss-sale-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    gap: 40px;
  }

  #{{ section.id }} .c-ss-sale-body {
    width: 100%;
    max-width: 554px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 45px;
    position: relative;
    z-index: 3;
  }

  #{{ section.id }} .c-ss-sale-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 31px;
    width: 100%;
  }

  #{{ section.id }} .c-ss-sale-top {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #{{ section.id }} .c-ss-sale-rating {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #FAFAF5;
    width: fit-content;
  }

  #{{ section.id }} .c-ss-sale-stars {
    display: inline-flex;
    gap: 4px;
  }

  #{{ section.id }} .c-ss-sale-stars svg {
    width: 14px;
    height: 14px;
    fill: #FF9500;
    display: block;
  }

  #{{ section.id }} .c-ss-sale-rating-text {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
    color: #1B1B1B;
  }

  #{{ section.id }} .c-ss-sale-heading {
    margin: 0;
    max-width: 467px;
    font-family: "Inter", sans-serif;
    font-size: 62px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -1.86px;
    color: #050505;
  }

  #{{ section.id }} .c-ss-sale-text {
    margin: 0;
    max-width: 509px;
    font-family: "Inter", sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #1F1F1F;
  }

  #{{ section.id }} .c-ss-sale-timer-wrap {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  #{{ section.id }} .c-ss-sale-timer-label {
    margin: 0;
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0.6px;
    color: #1B1B1B;
  }

  #{{ section.id }} .c-ss-sale-timer {
    display: flex;
    gap: 13px;
    flex-wrap: wrap;
  }

  #{{ section.id }} .c-ss-sale-timer-item {
    width: 65px;
    min-width: 65px;
    height: 57px;
    border-radius: 9px;
    background: #FAFAF5;
    border: 1px solid #C13325;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  #{{ section.id }} .c-ss-sale-timer-value {
    font-family: "Inter", sans-serif;
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
    color: #C13325;
  }

  #{{ section.id }} .c-ss-sale-timer-unit {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #C13325;
  }

  #{{ section.id }} .c-ss-sale-button {
    width: 318px;
    max-width: 100%;
    height: 60px;
    border-radius: 16px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.29;
    letter-spacing: 0;
    padding: 16px 63px;
    margin-top: -16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    text-decoration: none;
  }

  #{{ section.id }} .c-button.c-b1.c-ss-sale-button:hover {
    background-color: #C13325;
    color: #FFFFFF;
    opacity: 0.9;
    text-decoration: none;
  }

  #{{ section.id }} .c-ss-sale-button:focus,
  #{{ section.id }} .c-ss-sale-button:focus-visible,
  #{{ section.id }} .c-ss-sale-button:active {
    text-decoration: none;
  }

  #{{ section.id }} .c-ss-sale-image-wrap {
    width: 100%;
    max-width: 760px;
    margin-left: auto;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  #{{ section.id }} .c-ss-sale-image {
    width: 100%;
    max-width: 625px;
  }

  #{{ section.id }} .c-ss-sale-image img,
  #{{ section.id }} .c-ss-sale-image svg {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  #{{ section.id }} .c-ss-bg-top-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 244px;
    height: auto;
    z-index: 1;
    pointer-events: none;
    transform: scaleX(-1);
    transform-origin: center;
  }

  #{{ section.id }} .c-ss-bg-bottom-left {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 736px;
    height: auto;
    z-index: 1;
    pointer-events: none;
  }

  #{{ section.id }} .c-ss-bg-bottom-middle {
    display: none;
  }

  @media screen and (max-width: 1299px) {
    #{{ section.id }} .c-ss-sale-wrap {
      padding: 44px 28px 34px;
    }

    #{{ section.id }} .c-ss-sale-content {
      gap: 24px;
    }

    #{{ section.id }} .c-ss-sale-heading {
      font-size: 54px;
      max-width: 430px;
    }

    #{{ section.id }} .c-ss-sale-image-wrap {
      max-width: 650px;
    }
  }

  @media screen and (max-width: 1023px) {
    #{{ section.id }}.c-ss-header-sale-timer {
      padding: 0 20px 30px;
    }

    #{{ section.id }} .c-ss-sale-wrap {
      padding: 40px 20px;
      border-radius: 25px;
      min-height: 0;
    }

    #{{ section.id }} .c-ss-sale-content {
      flex-direction: column;
      align-items: center;
      gap: 30px;
    }

    #{{ section.id }} .c-ss-sale-body {
      max-width: none;
      gap: 31px;
      align-items: center;
      text-align: center;
    }

    #{{ section.id }} .c-ss-sale-text-wrap {
      gap: 24px;
      width: 100%;
    }

    #{{ section.id }} .c-ss-sale-rating {
      margin: 0 auto;
    }

    #{{ section.id }} .c-ss-sale-rating-text {
      font-size: 14px;
      font-weight: 400;
      line-height: 1.55;
      letter-spacing: 0.6px;
    }

    #{{ section.id }} .c-ss-sale-heading {
      font-size: 42px;
      max-width: 100%;
      letter-spacing: -1.86px;
    }

    #{{ section.id }} .c-ss-sale-text {
      font-size: 16px;
      line-height: 1.55;
      max-width: 90%;
      margin: 0 auto;
    }

    #{{ section.id }} .c-ss-sale-timer {
      gap: 10px;
    }

    #{{ section.id }} .c-ss-sale-timer-item {
      width: 55px;
      min-width: 55px;
      height: 50px;
      gap: 2px;
    }

    #{{ section.id }} .c-ss-sale-timer-value {
      font-size: 18px;
    }

    #{{ section.id }} .c-ss-sale-timer-unit {
      font-size: 10px;
      line-height: 1.55;
    }

    #{{ section.id }} .c-ss-sale-button {
      width: 100%;
      max-width: 100%;
      min-height: 0;
      border-radius: 10px;
      font-size: 18px;
      padding: 16px 50px;
      margin-top: 0;
    }

    #{{ section.id }} .c-ss-sale-image-wrap {
      max-width: none;
      margin: 0;
    }

    #{{ section.id }} .c-ss-sale-image {
      max-width: 100%;
    }

    #{{ section.id }} .c-ss-bg-top-right {
      width: 150px;
      top: 10px;
      right: 8px;
    }

    #{{ section.id }} .c-ss-bg-bottom-left {
      width: 360px;
    }

    #{{ section.id }} .c-ss-bg-bottom-middle {
      display: none;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1023px) {
    #{{ section.id }} .c-ss-sale-heading {
      font-size: 48px;
    }

    #{{ section.id }} .c-ss-sale-text {
      font-size: 18px;
    }

    #{{ section.id }} .c-ss-sale-timer {
      gap: 13px;
    }

    #{{ section.id }} .c-ss-sale-timer-item {
      width: 65px;
      min-width: 65px;
      height: 57px;
      gap: 4px;
    }

    #{{ section.id }} .c-ss-sale-timer-value {
      font-size: 20px;
    }

    #{{ section.id }} .c-ss-sale-timer-unit {
      font-size: 12px;
      line-height: 1.55;
    }

    #{{ section.id }} .c-ss-sale-button {
      width: auto;
      max-width: none;
      padding: 16px 63px;
      font-size: 20px;
    }
  }
{% endstyle %}

<section id="{{ section.id }}" class="c-ss-header-sale-timer">
