      <div class="c-promo-body">
        
        <div class="c-promo-text-wrap">
          {%- if section.settings.heading != blank -%}
            <h2 class="c-promo-heading">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <p class="c-promo-text">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <div class="c-promo-features">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature' -%}
                <div class="c-promo-feature glass-pill" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon -%}
                    <div class="c-promo-feature-icon">
                      {{ block.settings.icon | image_url: width: 36 | image_tag: loading: 'lazy' }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="c-promo-feature-text">{{ block.settings.text }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="c-promo-button">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}

      </div>
    </div>

